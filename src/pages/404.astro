---
import Base from '../layouts/Base.astro';
---
<Base lang="de" page="home" title="Seite nicht gefunden | Sion Consulting" description="Diese Seite gibt es nicht." noindex>
  <section class="page-hero">
    <div class="container stack-lg" style="max-width: 720px">
      <p class="eyebrow">404</p>
      <h1>Seite nicht gefunden</h1>
      <p class="lead">Die gesuchte Seite gibt es nicht oder nicht mehr. <span lang="en">This page does not exist.</span></p>
      <div class="btn-row">
        <a class="btn btn-accent" href="/">Zur Startseite</a>
        <a class="btn btn-ghost" href="/en/" lang="en">English homepage</a>
      </div>
    </div>
  </section>
</Base>
