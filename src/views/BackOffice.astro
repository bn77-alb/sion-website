---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import EmployerForm from '../components/EmployerForm.astro';
import Photo from '../components/Photo.astro';
import { site } from '../config';
import { type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;

const c = {
  de: {
    title: 'Back-Office-Services für KMU in Deutschland | SION Consulting',
    description: 'SION Consulting entlastet kleine und mittlere Unternehmen in Deutschland: Recruiting-Support, Logistik-Administration, Dokumente, Datenerfassung, E-Mail und Kundenkommunikation.',
    eyebrow: 'Back Office Services',
    h1: 'Back Office: operative Unterstützung für Ihr Unternehmen',
    lead: 'SION Consulting unterstützt kleine und mittlere Unternehmen in Deutschland aus unserem Büro heraus. Wir übernehmen wiederkehrende Verwaltungsaufgaben, damit sich Ihr Team auf das Kerngeschäft konzentrieren kann.',
    cta: 'Back-Office-Unterstützung anfragen',
    alt: 'Zwei Mitarbeitende besprechen Unterlagen am Schreibtisch',
    servicesH2: 'Was wir für Sie erledigen',
    services: [
      { icon: 'users', h: 'Recruiting-Support', p: 'Bewerberunterlagen sichten, Termine koordinieren und mit Kandidaten kommunizieren.' },
      { icon: 'truck', h: 'Logistik-Administration', p: 'Tourenunterlagen, Lieferscheine und Auftragsdaten pflegen und nachhalten.' },
      { icon: 'doc', h: 'Dokumentenbearbeitung', p: 'Verträge, Anschreiben und Standarddokumente nach Ihren Vorlagen – sauber und termingerecht.' },
      { icon: 'table', h: 'Datenerfassung', p: 'Erfassung und Pflege von Daten in Ihren Listen und Systemen.' },
      { icon: 'mail', h: 'E-Mail-Administration', p: 'Postfach sortieren, Standardanfragen beantworten, Wichtiges an Sie weiterleiten.' },
      { icon: 'headset', h: 'Kundenkommunikation', p: 'Freundliche und zuverlässige Kommunikation mit Ihren Kunden – auf Deutsch oder Englisch.' },
      { icon: 'calendar', h: 'Terminkoordination', p: 'Termine vereinbaren, bestätigen und im Kalender pflegen.' },
      { icon: 'idcard', h: 'Fahrer- & Dokumentenmanagement', p: 'Fahrerakten, Führerschein- und Fahrerkartenkontrollen, Nachweise und Fristen im Blick.' },
      { icon: 'folder', h: 'Allgemeine Verwaltung', p: 'Flexible Hilfe bei wiederkehrenden Büroaufgaben – Umfang nach Absprache.' },
    ],
    forH2: 'Für wen?',
    forList: ['Kleine und mittlere Unternehmen (KMU)', 'Speditionen & Logistik', 'Paket- und Kurierdienste', 'Personaldienstleister'],
    stepsH2: 'So starten wir',
    steps: [
      ['Erstgespräch', 'Wir besprechen, welche Aufgaben Sie abgeben möchten und in welchem Umfang.'],
      ['Aufgaben & Vorlagen festlegen', 'Gemeinsam definieren wir Abläufe, Vorlagen und Ansprechpartner.'],
      ['Laufende Bearbeitung', 'Wir erledigen die Aufgaben zuverlässig – mit einem festen Ansprechpartner für Sie.'],
    ],
    dpH2: 'Vertraulichkeit und Datenschutz',
    dpText: 'Wir behandeln Ihre Unterlagen vertraulich. Für die Verarbeitung personenbezogener Daten in Ihrem Auftrag schließen wir mit Ihnen einen Vertrag zur Auftragsverarbeitung nach Art. 28 DSGVO.',
    formH2: 'Back-Office-Unterstützung anfragen',
    formText: 'Beschreiben Sie kurz, welche Aufgaben Sie abgeben möchten. Wir melden uns innerhalb von 1 Werktag mit einem Vorschlag.',
    formCall: 'Lieber direkt sprechen?',
  },
  en: {
    title: 'Back-Office Services for SMEs in Germany | SION Consulting',
    description: 'SION Consulting supports small and medium-sized companies in Germany: recruitment support, logistics administration, documents, data entry, email and customer communication.',
    eyebrow: 'Back-office services',
    h1: 'Back office: operational support for your company',
    lead: 'SION Consulting supports small and medium-sized companies in Germany from our office. We take over recurring administrative tasks so your team can focus on the core business.',
    cta: 'Request back-office support',
    alt: 'Two colleagues discussing documents at a desk',
    servicesH2: 'What we do for you',
    services: [
      { icon: 'users', h: 'Recruitment support', p: 'Screening applicant files, coordinating interviews and communicating with candidates.' },
      { icon: 'truck', h: 'Logistics administration', p: 'Maintaining and following up route documents, delivery notes and order data.' },
      { icon: 'doc', h: 'Document processing', p: 'Contracts, letters and standard documents based on your templates – clean and on time.' },
      { icon: 'table', h: 'Data entry', p: 'Entering and maintaining data in your lists and systems.' },
      { icon: 'mail', h: 'Email administration', p: 'Sorting your inbox, answering standard requests, forwarding what matters to you.' },
      { icon: 'headset', h: 'Customer communication', p: 'Friendly, reliable communication with your customers – in German or English.' },
      { icon: 'calendar', h: 'Appointment coordination', p: 'Scheduling, confirming and maintaining appointments in your calendar.' },
      { icon: 'idcard', h: 'Driver & document management', p: 'Driver files, licence and driver card checks, certificates and deadlines under control.' },
      { icon: 'folder', h: 'General administration', p: 'Flexible help with recurring office tasks – scope as agreed.' },
    ],
    forH2: 'Who is it for?',
    forList: ['Small and medium-sized companies (SMEs)', 'Hauliers & logistics', 'Parcel and courier services', 'Staffing agencies'],
    stepsH2: 'How we get started',
    steps: [
      ['First call', 'We discuss which tasks you want to hand over and to what extent.'],
      ['Define tasks & templates', 'Together we set up processes, templates and contact persons.'],
      ['Ongoing work', 'We handle the tasks reliably – with one fixed contact person for you.'],
    ],
    dpH2: 'Confidentiality and data protection',
    dpText: 'We treat your documents confidentially. For processing personal data on your behalf, we conclude a data processing agreement with you under Art. 28 GDPR.',
    formH2: 'Request back-office support',
    formText: 'Briefly describe which tasks you would like to hand over. We will get back to you within 1 working day with a proposal.',
    formCall: 'Prefer to talk directly?',
  },
}[lang];
---
<Base lang={lang} page="backoffice" title={c.title} description={c.description}>
  <section class="page-hero">
    <div class="container grid-2">
      <div class="hero-copy">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1>{c.h1}</h1>
        <p class="lead">{c.lead}</p>
        <div class="btn-row"><a class="btn btn-accent btn-lg" href="#anfrage">{c.cta}</a></div>
      </div>
      <div class="media ratio-landscape hide-mobile-block">
        <Photo name="backoffice" alt={c.alt} priority hideOnMobile sizes="(max-width: 760px) 1px, 50vw" />
      </div>
    </div>
  </section>

  <section class="section section-first">
    <div class="container">
      <div class="section-head"><h2>{c.servicesH2}</h2></div>
      <div class="grid-3">
        {c.services.map((s) => (
          <article class="card">
            <Icon name={s.icon} class="card-icon" />
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-soft">
    <div class="container grid-2" style="align-items: start">
      <div class="stack-lg">
        <h2>{c.forH2}</h2>
        <div class="chips">{c.forList.map((x) => <span class="chip">{x}</span>)}</div>
        <div class="stack" style="margin-top: 16px">
          <h3>{c.dpH2}</h3>
          <p class="muted">{c.dpText}</p>
        </div>
      </div>
      <div class="stack-lg">
        <h2>{c.stepsH2}</h2>
        <ol class="steps" style="grid-template-columns: 1fr">
          {c.steps.map(([h, p]) => <li><h3>{h}</h3><p>{p}</p></li>)}
        </ol>
      </div>
    </div>
  </section>

  <section id="anfrage" class="section band-sand">
    <div class="container form-layout">
      <div class="stack-lg">
        <h2>{c.formH2}</h2>
        <p class="muted">{c.formText}</p>
        <p><strong>{c.formCall}</strong><br /><a class="big-phone" href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
      </div>
      <EmployerForm lang={lang} position="backoffice" />
    </div>
  </section>
</Base>
