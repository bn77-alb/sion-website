      eyebrow: 'Recruitment', h1: 'Kitchen helpers and kitchen staff for your business',
      lead: 'Reliable kitchen helpers, dishwashers and cooks for restaurants, hotels, canteens, catering and commercial kitchens – nationwide, from Germany, the EU, the Western Balkans and non-EU countries such as India and Uzbekistan.',
      serviceType: 'Recruitment of kitchen and hospitality staff',
      areas: ['Restaurants', 'Hotels', 'Canteens & commercial kitchens', 'Catering', 'Quick-service restaurants'],
      roles: ['Kitchen helpers', 'Dishwashers', 'Commis cooks', 'Cooks – depending on availability', 'Breakfast helpers in hotels', 'Helpers for canteens and catering'],
      req: ['Kitchen experience – depending on the candidate', 'Awareness of hygiene; we organise the food hygiene instruction under the Infection Protection Act with you before the start', 'Weekend and shift work as agreed', 'German skills vary by candidate – we tell you honestly in advance'],
      faq: [
        { q: 'Which kitchen staff do you recruit?', a: 'Kitchen helpers, dishwashers, commis cooks, cooks and helpers for breakfast, canteens and catering. For qualified cooks it depends on availability – we tell you honestly in advance.' },
        { q: 'Do kitchen helpers need a food hygiene instruction?', a: 'Anyone working commercially with food needs an initial instruction under section 43 of the German Infection Protection Act before the first shift, usually at the public health office. We organise the appointment with you and the employee.' },
        { q: 'Can the employees work weekends and shifts?', a: 'Yes, as agreed. Tell us your working hours – we only introduce candidates who accept them.' },
        'speed:kitchen helpers', 'abroad', 'cost', 'direct',
      ],
    },
  },
  helfer: {
    image: 'helfer', icon: 'gear', focus: undefined, origins: ['de', 'eu', 'wb', 'third'],
    alt: { de: 'Produktionshelfer an einer Fertigungslinie', en: 'Production helpers on a production line' },
    de: {
      title: 'Produktionshelfer & Hilfskräfte vermitteln | SION',
      description: 'Produktionshelfer, Montagehelfer und Hilfskräfte für Industrie, Handwerk und Gewerbe in ganz Deutschland. Direkte Anstellung, keine Anzahlung.',
      eyebrow: 'Personalvermittlung', h1: 'Helfer für Produktion, Montage und Gewerbe',
      lead: 'Zuverlässige Hilfskräfte für Produktion, Montage, Verpackung und andere gewerbliche Tätigkeiten – bundesweit, aus Deutschland, der EU, dem Westbalkan und Drittstaaten wie Indien und Usbekistan.',
      serviceType: 'Personalvermittlung Produktionshelfer und Hilfskräfte',
      areas: ['Produktion', 'Montage', 'Verpackung', 'Gewerbliche Hilfstätigkeiten'],
      roles: ['Produktionshelfer', 'Montagehelfer', 'Maschinenbediener nach Einarbeitung', 'Mitarbeiter für Verpackung und Konfektionierung', 'Allgemeine Hilfskräfte für Gewerbe und Handwerk'],
      req: ['Erfahrung in Produktion oder Handwerk – je nach Kandidat', 'Zuverlässigkeit und Bereitschaft zur Einarbeitung', 'Schichtarbeit nach Absprache', 'Deutschkenntnisse je nach Kandidat – wir nennen sie Ihnen ehrlich vorab'],
      faq: [
        { q: 'Welche Hilfskräfte vermitteln Sie?', a: 'Produktionshelfer, Montagehelfer, Mitarbeiter für Verpackung sowie allgemeine Hilfskräfte für Gewerbe und Handwerk. Beschreiben Sie uns die Tätigkeit – wir sagen Ihnen ehrlich, ob wir passende Kandidaten haben.' },
        { q: 'Dürfen Hilfskräfte aus Drittstaaten in Deutschland arbeiten?', a: 'Für Tätigkeiten ohne Berufsabschluss gibt es nur bestimmte Wege, etwa die Westbalkanregelung oder befristete Beschäftigungen mit Voraussetzungen für den Arbeitgeber. Welcher Weg für Ihre Stelle in Frage kommt, prüfen wir vorab mit Ihnen; die Entscheidung trifft die Bundesagentur für Arbeit.' },
        'speed:Hilfskräfte', 'cost', 'direct', 'region',
      ],
    },
    en: {
      title: 'Production Helpers & General Workers Recruitment | SION',
      description: 'Production helpers, assembly helpers and general workers for industry, trades and businesses across Germany. Direct employment, no deposit.',
      eyebrow: 'Recruitment', h1: 'Helpers for production, assembly and trades',
      lead: 'Reliable helpers for production, assembly, packaging and other manual work – nationwide, from Germany, the EU, the Western Balkans and non-EU countries such as India and Uzbekistan.',
      serviceType: 'Recruitment of production helpers and general workers',
      areas: ['Production', 'Assembly', 'Packaging', 'General manual work'],
      roles: ['Production helpers', 'Assembly helpers', 'Machine operators after training', 'Packaging and order assembly staff', 'General helpers for businesses and trades'],
      req: ['Experience in production or trades – depending on the candidate', 'Reliability and willingness to be trained', 'Shift work as agreed', 'German skills vary by candidate – we tell you honestly in advance'],
      faq: [
        { q: 'Which helpers do you recruit?', a: 'Production helpers, assembly helpers, packaging staff and general helpers for businesses and trades. Describe the work to us – we will tell you honestly whether we have suitable candidates.' },
        { q: 'Can helpers from non-EU countries work in Germany?', a: 'For jobs without a vocational qualification there are only certain routes, such as the Western Balkans regulation or limited-term employment with requirements for the employer. We check with you in advance which route is possible for your position; the decision is made by the Federal Employment Agency.' },
        'speed:helpers', 'cost', 'direct', 'region',
      ],
    },
  },
};
const page = pages[service];
const p = page[lang];
const faq = p.faq.map((f) => {
  if (typeof f !== 'string') return f;
  if (f.startsWith('speed:')) return shared.speed(f.slice(6));
  return shared[f as 'cost' | 'direct' | 'region' | 'abroad'];
});
const origins = page.origins.map((k) => common.origins[k as keyof typeof common.origins]);
const others = (['lkw', 'paket', 'lager', 'reinigung', 'bau', 'kueche', 'helfer', 'saison', 'backoffice'] as const).filter((k) => k !== service);
const otherLabels = {
  de: { lkw: 'LKW-Fahrer', paket: 'Paketzusteller', lager: 'Lager & Logistik', reinigung: 'Reinigung', bau: 'Bau', kueche: 'Küche & Gastronomie', helfer: 'Helfer & Produktion', saison: 'Saisonarbeit', backoffice: 'Back Office' },
  en: { lkw: 'Truck drivers', paket: 'Parcel delivery', lager: 'Warehouse & logistics', reinigung: 'Cleaning', bau: 'Construction', kueche: 'Kitchen & hospitality', helfer: 'Helpers & production', saison: 'Seasonal work', backoffice: 'Back office' },
}[lang];
const url = new URL(routes[service][lang], site.url).href;
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Service',
    name: p.h1, serviceType: p.serviceType, description: p.description, url, inLanguage: lang,
    provider: { '@type': 'EmploymentAgency', name: site.name, url: `${site.url}/`, email: site.email, logo: `${site.url}/icon-512.png` },
    areaServed: { '@type': 'Country', name: common.area },
    audience: { '@type': 'BusinessAudience', name: lang === 'de' ? 'Unternehmen in Deutschland' : 'Companies in Germany' },
    ...(p.roles.length ? { hasOfferCatalog: { '@type': 'OfferCatalog', name: common.rolesH2, itemListElement: p.roles.map((r) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: r } })) } } : {}),
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base lang={lang} page={service} title={p.title} description={p.description} schema={schema} stickyCta="#anfrage">
  <section class="page-hero">
    <div class="container grid-2">
      <div class="hero-copy">
        <p class="eyebrow">{p.eyebrow}</p>
        <h1>{p.h1}</h1>
        <p class="lead">{p.lead}</p>
        <div class="btn-row">
          <a class="btn btn-accent btn-lg" href="#anfrage">{common.cta}</a>
          <a class="btn btn-ghost btn-lg" href={routes.kontakt[lang]}>{common.cta2}</a>
        </div>
        <ul class="chips">{p.areas.map((a) => <li><span class="chip">{a}</span></li>)}</ul>
      </div>
      {hasPhoto(page.image) ? (
        <div class="media ratio-landscape hide-mobile-block">
          <Photo name={page.image} alt={page.alt[lang]} focus={page.focus} priority hideOnMobile sizes="(max-width: 760px) 1px, 50vw" />
        </div>
      ) : (
        <div class="icon-panel hide-mobile-block" aria-hidden="true"><Icon name={page.icon} size={120} /></div>
      )}
    </div>
  </section>

  <section class="section section-first">
    <div class="container">
      <div class="section-head"><h2>{common.whatH2}</h2></div>
      <div class="grid-4">
        {common.what.map((s) => (
          <article class="card">
            <Icon name={s.icon} class="card-icon" />
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-soft">
    <div class="container grid-2" style="align-items: start">
      {p.roles.length > 0 && (
        <div class="stack-lg">
          <h2>{common.rolesH2}</h2>
          <ul class="checklist">{p.roles.map((x) => <li>{x}</li>)}</ul>
        </div>
      )}
      <div class="stack-lg">
        <h2>{common.reqH2}</h2>
        <ul class="checklist">{p.req.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>{common.originH2}</h2></div>
      <div class:list={[origins.length === 4 ? 'grid-4' : 'grid-3']}>
        {origins.map(([icon, h, text]) => (
          <article class="card">
            <Icon name={icon} class="card-icon" />
            <h3>{h}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
      <p class="muted" style="margin-top: 20px; font-size: .95rem">{common.originNote}</p>
    </div>
  </section>

  <section class="band-dark section">
    <div class="container">
      <div class="section-head"><p class="eyebrow">{common.procEyebrow}</p><h2>{common.procH2}</h2></div>
      <Steps lang={lang} />
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container narrow">
      <div class="section-head"><h2>{common.faqH2}</h2></div>
      <Faq items={faq} />
      <h2 class="h2-sm" style="margin-top: 40px">{common.other}</h2>
      <ul class="chips">{others.map((k) => <li><a class="chip" href={routes[k][lang]}>{otherLabels[k]}</a></li>)}</ul>
    </div>
  </section>

  <section id="anfrage" class="section band-sand">
    <div class="container form-layout">
      <div class="stack-lg">
        <h2>{common.formH2}</h2>
        <p class="muted">{common.formText}</p>
        <p><strong>{common.formCall}</strong><br /><a class="big-phone" href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <EmployerForm lang={lang} position={service} />
    </div>
  </section>
</Base>
