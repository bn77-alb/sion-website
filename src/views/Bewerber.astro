---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Faq from '../components/Faq.astro';
import CandidateForm from '../components/CandidateForm.astro';
import { ui, type Lang } from '../i18n';
import { site } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;

const c = {
  de: {
    title: 'Jobs in Deutschland für LKW-Fahrer, Zusteller & Logistik | SION Consulting',
    description: 'Sie suchen einen Job in Deutschland als LKW-Fahrer, Paketzusteller, im Lager oder in der Reinigung? Bewerben Sie sich bei SION Consulting – wir begleiten Sie bis zum ersten Arbeitstag.',
    eyebrow: 'Für Bewerberinnen und Bewerber',
    h1: 'Ihr Job in Deutschland – sicher und begleitet',
    lead: 'Wir vermitteln Sie an Unternehmen in Deutschland und begleiten Sie durch alle Schritte: Bewerbung, Vorstellungsgespräch, Unterlagen und Ankunft.',
    cta: 'Ich suche einen Job',
    alt: 'Mitarbeitende in einem Logistiklager',
    jobsH2: 'Für diese Tätigkeiten suchen wir',
    jobs: [
      { icon: 'truck', h: 'LKW-Fahrer C/CE', p: 'Fern-, Nah- und Verteilerverkehr für Speditionen und Logistikunternehmen.' },
      { icon: 'package', h: 'Paketzusteller', p: 'Zustellung von Paketen mit dem Transporter, Führerschein Klasse B.' },
      { icon: 'warehouse', h: 'Lager & Logistik', p: 'Kommissionierung, Verladung, Wareneingang und Versand.' },
      { icon: 'sparkle', h: 'Reinigung', p: 'Reinigung von Büros, Objekten und Gewerbeflächen.' },
    ],
    needH: 'Was Sie mitbringen',
    need: ['Gültiger Reisepass', 'Führerschein – je nach Stelle Klasse B, C oder CE', 'Berufserfahrung im gewünschten Bereich', 'Zuverlässigkeit und Motivation'],
    offerH: 'Was wir für Sie tun',
    offer: ['Passende Stelle bei einem Arbeitgeber in Deutschland', 'Unterstützung bei Unterlagen, Anträgen und Terminen', 'Hilfe bei Anreise, Unterkunftssuche und Anmeldung', 'Ansprechpartner auf Deutsch, Englisch und Albanisch'],
    stepsH2: 'In vier Schritten zum Job in Deutschland',
    steps: [
      ['Bewerbung senden', 'Über das Formular, per E-Mail oder WhatsApp.'],
      ['Gespräch', 'Wir lernen Sie kennen und prüfen Ihre Unterlagen.'],
      ['Vorstellung beim Arbeitgeber', 'Der Arbeitgeber lernt Sie kennen – oft per Video.'],
      ['Unterlagen & Start', 'Wir unterstützen bei den Formalitäten bis zum ersten Arbeitstag.'],
    ],
    faqH2: 'Fragen von Bewerbern',
    faq: [
      { q: 'Muss ich Deutsch sprechen?', a: 'Das hängt von der Stelle und dem Arbeitgeber ab. Deutschkenntnisse sind immer ein Vorteil – sprechen Sie uns an.' },
      { q: 'Kann ich mich auch bewerben, wenn ich schon in Deutschland lebe?', a: 'Ja. Wir helfen auch beim Wechsel zu einem neuen Arbeitgeber in Deutschland.' },
      { q: 'Welche Unterlagen brauche ich?', a: 'Zunächst reichen Ihre Kontaktdaten, Ihr Beruf und Ihre Führerscheinklassen. Lebenslauf, Pass und Führerschein fragen wir im nächsten Schritt an.' },
    ],
    formH2: 'Ich suche einen Job',
    formText: 'Füllen Sie das kurze Formular aus. Wir melden uns, sobald wir eine passende Stelle für Sie haben.',
    whatsapp: 'Lieber per WhatsApp?',
  },
  en: {
    title: 'Jobs in Germany for Truck Drivers, Delivery & Logistics | SION Consulting',
    description: 'Looking for a job in Germany as a truck driver, parcel delivery driver, in a warehouse or in cleaning? Apply with SION Consulting – we support you up to your first working day.',
    eyebrow: 'For applicants',
    h1: 'Your job in Germany – safe and supported',
    lead: 'We place you with companies in Germany and support you through every step: application, interview, documents and arrival.',
    cta: 'I am looking for a job',
    alt: 'Workers in a logistics warehouse',
    jobsH2: 'Jobs we recruit for',
    jobs: [
      { icon: 'truck', h: 'Truck driver C/CE', p: 'Long-haul, regional and distribution transport for hauliers and logistics companies.' },
      { icon: 'package', h: 'Parcel delivery driver', p: 'Delivering parcels by van, class B licence.' },
      { icon: 'warehouse', h: 'Warehouse & logistics', p: 'Order picking, loading, goods receipt and dispatch.' },
      { icon: 'sparkle', h: 'Cleaning', p: 'Cleaning offices, buildings and commercial spaces.' },
    ],
    needH: 'What you need',
    need: ['A valid passport', 'Driving licence – class B, C or CE depending on the job', 'Work experience in the field you want', 'Reliability and motivation'],
    offerH: 'What we do for you',
    offer: ['A suitable job with an employer in Germany', 'Assistance with documents, applications and appointments', 'Help with travel, finding accommodation and registration', 'Contact person in German, English and Albanian'],
    stepsH2: 'Four steps to your job in Germany',
    steps: [
      ['Send your application', 'Via the form, by email or WhatsApp.'],
      ['Interview', 'We get to know you and check your documents.'],
      ['Meet the employer', 'The employer gets to know you – often by video.'],
      ['Documents & start', 'We assist with the formalities up to your first working day.'],
    ],
    faqH2: 'Questions from applicants',
    faq: [
      { q: 'Do I need to speak German?', a: 'That depends on the job and the employer. German skills are always an advantage – just ask us.' },
      { q: 'Can I apply if I already live in Germany?', a: 'Yes. We also help with changing to a new employer in Germany.' },
      { q: 'Which documents do I need?', a: 'To start, your contact details, your job and your licence classes are enough. We will ask for your CV, passport and licence in the next step.' },
    ],
    formH2: 'I am looking for a job',
    formText: 'Fill in the short form. We will contact you as soon as we have a suitable job for you.',
    whatsapp: 'Prefer WhatsApp?',
  },
}[lang];
---
<Base lang={lang} page="bewerber" title={c.title} description={c.description}>
  <section class="page-hero">
    <div class="container grid-2">
      <div class="hero-copy">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1>{c.h1}</h1>
        <p class="lead">{c.lead}</p>
        <div class="btn-row">
          <a class="btn btn-accent btn-lg" href="#bewerbung">{c.cta}</a>
          <a class="btn btn-whatsapp btn-lg" href={site.whatsapp} rel="noopener" target="_blank"><Icon name="whatsapp" size={20} /> {ui[lang].whatsappWrite}</a>
        </div>
      </div>
      <div class="media ratio-landscape hide-mobile-block">
        <Photo name="lager" alt={c.alt} priority hideOnMobile sizes="(max-width: 760px) 1px, 50vw" />
      </div>
    </div>
  </section>

  <section class="section section-first">
    <div class="container">
      <div class="section-head"><h2>{c.jobsH2}</h2></div>
      <div class="grid-4">
        {c.jobs.map((j) => (
          <article class="card">
            <Icon name={j.icon} class="card-icon" />
            <h3>{j.h}</h3>
            <p>{j.p}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-soft">
    <div class="container grid-2" style="align-items: stretch">
      <div class="card"><h3>{c.needH}</h3><ul class="checklist">{c.need.map((x) => <li>{x}</li>)}</ul></div>
      <div class="card"><h3>{c.offerH}</h3><ul class="checklist">{c.offer.map((x) => <li>{x}</li>)}</ul></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>{c.stepsH2}</h2></div>
      <ol class="steps">{c.steps.map(([h, p]) => <li><h3>{h}</h3><p>{p}</p></li>)}</ol>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container narrow">
      <div class="section-head"><h2>{c.faqH2}</h2></div>
      <Faq items={c.faq} />
    </div>
  </section>

  <section id="bewerbung" class="section band-sand">
    <div class="container form-layout">
      <div class="stack-lg">
        <h2>{c.formH2}</h2>
        <p class="muted">{c.formText}</p>
        <p><strong>{c.whatsapp}</strong><br /><a class="big-phone" href={site.whatsapp} rel="noopener" target="_blank">{site.phone}</a></p>
      </div>
      <CandidateForm lang={lang} />
    </div>
  </section>
</Base>
