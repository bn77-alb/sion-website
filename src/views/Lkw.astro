---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import EmployerForm from '../components/EmployerForm.astro';
import PricingBox from '../components/PricingBox.astro';
import { routes, type Lang } from '../i18n';
import { site } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;

const c = {
  de: {
    title: 'Personalvermittlung LKW-Fahrer: CE-Fahrer aus der EU & dem Westbalkan | SION Consulting',
    description: 'Personalvermittlung LKW-Fahrer: CE-Fahrer aus der EU, dem Westbalkan und Deutschland – direkte Anstellung, keine Zeitarbeit, keine Anzahlung. Zahlung erst nach 30 Tagen.',
    eyebrow: 'Personalvermittlung für Transport & Logistik',
    h1: 'Personalvermittlung LKW-Fahrer',
    lead: 'Wir vermitteln qualifizierte CE-Fahrer und Berufskraftfahrer aus der EU, dem Westbalkan und Deutschland an Transport- und Logistikunternehmen in ganz Deutschland – von der Kandidatensuche bis zum ersten Arbeitstag.',
    cta: 'LKW-Fahrer anfragen', cta2: 'Kostenloses Erstgespräch',
    alt: 'Personalvermittlung LKW-Fahrer: Sattelzug auf einer Landstraße',
    areas: ['Fernverkehr', 'Nahverkehr', 'Verteilerverkehr', 'Sattelzug & Hängerzug'],
    servicesEyebrow: 'Leistungen', servicesH2: 'Was wir bei der Vermittlung von Berufskraftfahrern übernehmen',
    services: [
      { icon: 'truck', h: 'Rekrutierung von CE-Fahrern', p: 'Gezielte Suche nach Fahrern, die zu Ihren Touren, Fahrzeugen und Arbeitszeiten passen.' },
      { icon: 'globe', h: 'Fahrer aus der EU, dem Westbalkan und Deutschland', p: 'Fahrer mit Aufenthalt in einem EU-Land, Fahrer aus dem Westbalkan und Fahrer, die bereits in Deutschland leben.' },
      { icon: 'search', h: 'Vorauswahl (Pre-Screening)', p: 'Führerschein, Fahrpraxis, Fahrzeugtypen und Unterlagen werden vor der Vorstellung geprüft.' },
      { icon: 'users', h: 'Vorstellungsgespräche', p: 'Sie lernen die Kandidaten vor Ort oder per Video kennen und entscheiden selbst.' },
      { icon: 'doc', h: 'Arbeitsvertrag', p: 'Wir koordinieren den Ablauf rund um Ihr Vertragsangebot und die benötigten Unterlagen.' },
      { icon: 'idcard', h: 'Führerscheinumschreibung', p: 'Unterstützung bei der Vorbereitung der Unterlagen und den Terminen bei der Fahrerlaubnisbehörde.' },
      { icon: 'award', h: 'Code 95 / Fahrerqualifizierungsnachweis', p: 'Organisation der erforderlichen Berufskraftfahrer-Qualifikation gemeinsam mit dem Fahrer.' },
      { icon: 'folder', h: 'Zustimmung & Aufenthalt', p: 'Administrative Unterstützung bei Anträgen, Unterlagen und Terminen – z. B. im Verfahren nach der Westbalkanregelung.' },
      { icon: 'plane', h: 'Relocation & Onboarding', p: 'Hilfe bei Anreise, Unterkunftssuche, Anmeldung und den ersten Wochen im neuen Job.' },
      { icon: 'handshake', h: 'Direkte Anstellung', p: 'Der Fahrer wird direkt bei Ihnen angestellt – keine Arbeitnehmerüberlassung.' },
    ],
    qualEyebrow: 'Gut zu wissen',
    qualH2: 'Führerschein, Code 95 und Fahrerqualifizierungsnachweis',
    qualText: [
      'Wer in Deutschland gewerblich LKW fährt, braucht eine gültige Fahrerlaubnis der Klasse C bzw. CE und die Berufskraftfahrer-Qualifikation. Nachgewiesen wird sie durch die Schlüsselzahl 95 im Führerschein oder – bei Fahrern mit Führerschein aus einem Drittstaat – durch den Fahrerqualifizierungsnachweis (FQN).',
      'Führerscheine aus Albanien, Kosovo, Montenegro, Nordmazedonien und Serbien – auch Klasse C und CE – können in Deutschland ohne theoretische und praktische Prüfung umgeschrieben werden (Anlage 11 FeV). Welche Schritte im Einzelfall nötig sind, klären wir vor der Einstellung mit Ihnen und den zuständigen Stellen.',
    ],
    note: 'Wir unterstützen bei administrativen Prozessen und der Vorbereitung erforderlicher Unterlagen. Eine Rechtsberatung bieten wir nicht an; verbindliche Entscheidungen treffen die zuständigen Behörden.',
    procEyebrow: 'Ablauf', procH2: 'So läuft die Vermittlung von LKW-Fahrern ab',
    steps: [
      ['Bedarf mitteilen', 'Touren, Fahrzeugtyp, Einsatzort, Arbeitszeiten und gewünschte Anzahl an Fahrern.'],
      ['Suche & Vorauswahl', 'Wir suchen in der EU, im Westbalkan und in Deutschland, führen Vorgespräche und prüfen Führerschein und Unterlagen.'],
      ['Vorstellungsgespräch', 'Sie sprechen mit den vorgeschlagenen Fahrern – auch per Video – und treffen Ihre Wahl.'],
      ['Vertrag & Unterlagen', 'Sie erstellen das Vertragsangebot, wir unterstützen bei Anträgen und Unterlagen – z. B. für die Zustimmung der Bundesagentur für Arbeit.'],
      ['Umzug & Onboarding', 'Anmeldung, Wohnungssuche, ggf. Führerscheinumschreibung und Qualifikation – wir begleiten organisatorisch.'],
      ['Arbeitsbeginn', 'Der Fahrer startet bei Ihnen. Wir bleiben in den ersten Wochen Ihr Ansprechpartner.'],
    ] as [string, string][],
    timing: 'Zeitrahmen: Fahrer, die bereits in Deutschland leben, können oft innerhalb von 2–4 Wochen starten. Bei Fahrern aus anderen EU-Ländern hängt es vom Einzelfall ab – oft einige Wochen bis wenige Monate. Über die Westbalkanregelung dauert es wegen Kontingent und Visumterminen oft mehrere Monate.',
    directH2: 'Direkte Anstellung – volle Kontrolle für Sie',
    directText: 'Die Fahrer werden direkt in Ihrem Unternehmen angestellt. Sie entscheiden über Auswahl, Vertrag und Einsatz. Wir übernehmen Suche, Vorauswahl und die organisatorische Begleitung.',
    faqH2: 'Häufige Fragen zur Vermittlung von LKW-Fahrern',
    faq: [
      { q: 'Sind die Fahrer sofort einsetzbar?', a: 'Für den gewerblichen Güterverkehr brauchen Fahrer einen gültigen Führerschein C/CE und die Berufskraftfahrer-Qualifikation (Code 95 bzw. Fahrerqualifizierungsnachweis). Ein ausländischer Führerschein muss in der Regel innerhalb von sechs Monaten nach Wohnsitznahme umgeschrieben werden. Für Führerscheine aus Albanien, Kosovo, Montenegro, Nordmazedonien und Serbien – auch Klasse C und CE – geht das ohne theoretische und praktische Prüfung. Was im Einzelfall nötig ist, klären wir vor der Einstellung.' },
      { q: 'Können Fahrer zunächst in einer anderen Tätigkeit anfangen?', a: 'Unter bestimmten Voraussetzungen ist das möglich, etwa eine Beschäftigung im Lager, während die Qualifikation erworben wird. Ob das in Ihrem Fall in Frage kommt, entscheidet die Bundesagentur für Arbeit. Wir unterstützen bei der Vorbereitung der Unterlagen.' },
      { q: 'Welche Erfahrung bringen die Fahrer mit?', a: 'Wir vermitteln Fahrer mit Berufserfahrung. Fahrpraxis, Fahrzeugtypen und bisherige Einsätze klären wir im Gespräch und nennen sie Ihnen im Profil.' },
      { q: 'Wer trägt die Kosten für Umschreibung und Code 95?', a: 'Die Kosten für Führerscheinumschreibung und Grundqualifikation trägt der Fahrer. Wir organisieren und begleiten den Ablauf.' },
      { q: 'Aus welchen Ländern kommen Ihre Fahrer?', a: 'Aus der EU, dem Westbalkan und Deutschland: Fahrer, die bereits mit Aufenthaltstitel in einem EU-Land leben und arbeiten (oft mit EU-Führerschein und Code 95), Staatsangehörige aus Albanien, Kosovo, Nordmazedonien, Serbien, Montenegro sowie Bosnien und Herzegowina, EU-Bürger und Fahrer, die bereits in Deutschland leben.' },
      { q: 'Können wir mehrere Fahrer gleichzeitig anfragen?', a: 'Ja. Teilen Sie uns die gewünschte Anzahl mit – wir planen die Auswahl entsprechend.' },
    ],
    euEyebrow: 'Schnellster Weg', euH2: 'Fahrer mit EU-Führerschein und Code 95 – bereits in der EU tätig',
    euText: 'Viele erfahrene CE-Fahrer leben und arbeiten bereits mit Aufenthaltstitel in Polen, Litauen, den Niederlanden oder Tschechien und möchten nach Deutschland wechseln.',
    euList: ['Europäische Fahrpraxis – Mautsysteme, Lenk- und Ruhezeiten, Tachograph', 'EU-Führerschein und Code 95 gelten in Deutschland – keine Umschreibung nötig', 'Oft schnellerer Start als bei Kandidaten von außerhalb der EU'],
    euLink: 'Infos für Fahrer in der EU', wbLink: 'Westbalkanregelung für LKW-Fahrer',
    formH2: 'LKW-Fahrer anfragen',
    formText: 'Beschreiben Sie kurz Ihren Bedarf – Touren, Fahrzeugtyp, Einsatzort. Wir melden uns innerhalb von 1 Werktag mit einem Vorschlag.',
    formCall: 'Lieber per E-Mail?',
  },
  en: {
    title: 'Truck Driver Recruitment: CE Drivers from the EU & Western Balkans | SION Consulting',
    description: 'Truck driver recruitment: CE drivers from the EU, the Western Balkans and Germany – direct employment, no temporary agency work, no deposit. Payment only after 30 days.',
    eyebrow: 'Recruitment for transport & logistics',
    h1: 'Truck driver recruitment',
    lead: 'We place qualified CE drivers and professional drivers from the EU, the Western Balkans and Germany with transport and logistics companies across Germany – from the candidate search to the first working day.',
    cta: 'Request truck drivers', cta2: 'Free initial consultation',
    alt: 'Truck driver recruitment: semi-trailer truck on a country road',
    areas: ['Long-haul', 'Regional transport', 'Distribution', 'Semi-trailer & drawbar'],
    servicesEyebrow: 'Services', servicesH2: 'What we take care of when recruiting professional drivers',
    services: [
      { icon: 'truck', h: 'CE driver recruitment', p: 'Targeted search for drivers who match your routes, vehicles and working hours.' },
      { icon: 'globe', h: 'Drivers from the EU, the Western Balkans and Germany', p: 'Drivers living in an EU country, drivers from the Western Balkans and drivers already living in Germany.' },
      { icon: 'search', h: 'Pre-screening', p: 'Licence, driving experience, vehicle types and documents are checked before we present anyone.' },
      { icon: 'users', h: 'Employer interviews', p: 'You meet the candidates on site or by video and make the decision yourself.' },
      { icon: 'doc', h: 'Employment contract', p: 'We coordinate the process around your contract offer and the documents required.' },
      { icon: 'idcard', h: 'Licence conversion', p: 'Assistance preparing the documents and appointments with the driving licence authority.' },
      { icon: 'award', h: 'Code 95 / driver qualification card', p: 'Organising the required professional driver qualification together with the driver.' },
      { icon: 'folder', h: 'Approval & residence', p: 'Administrative assistance with applications, documents and appointments – e.g. under the Western Balkans regulation.' },
      { icon: 'plane', h: 'Relocation & onboarding', p: 'Help with travel, finding accommodation, registration and the first weeks in the new job.' },
      { icon: 'handshake', h: 'Direct employment', p: 'The driver is employed directly by you – no temporary agency work.' },
    ],
    qualEyebrow: 'Good to know',
    qualH2: 'Driving licence, Code 95 and driver qualification card',
    qualText: [
      'Anyone driving a truck commercially in Germany needs a valid class C or CE licence and the professional driver qualification. It is shown by code 95 on the licence or – for drivers with a licence from a non-EU country – by the driver qualification card (Fahrerqualifizierungsnachweis, FQN).',
      'Licences from Albania, Kosovo, Montenegro, North Macedonia and Serbia – including classes C and CE – can be converted in Germany without a theory or practical test (Annex 11 of the German Driving Licence Regulation). We clarify the steps needed in each case with you and the competent authorities before hiring.',
    ],
    note: 'We assist with administrative processes and the preparation of required documents. We do not provide legal advice; binding decisions are made by the competent authorities.',
    procEyebrow: 'Process', procH2: 'How recruiting truck drivers works',
    steps: [
      ['Tell us what you need', 'Routes, vehicle type, location, working hours and the number of drivers.'],
      ['Search & pre-selection', 'We search in the EU, the Western Balkans and Germany, hold first interviews and check licences and documents.'],
      ['Interview', 'You talk to the proposed drivers – also by video – and make your choice.'],
      ['Contract & documents', 'You issue the contract offer; we assist with applications and documents – e.g. for the approval of the Federal Employment Agency.'],
      ['Move & onboarding', 'Registration, finding a flat, licence conversion and qualification if needed – we provide organisational support.'],
      ['First working day', 'The driver starts with you. We remain your contact person during the first weeks.'],
    ] as [string, string][],
    timing: 'Timeframe: drivers who already live in Germany can often start within 2–4 weeks. For drivers from other EU countries it depends on the individual case – often a few weeks to a few months. Under the Western Balkans regulation it often takes several months because of the quota and visa appointments.',
    directH2: 'Direct employment – you stay in control',
    directText: 'The drivers are employed directly by your company. You decide on selection, contract and deployment. We handle the search, pre-selection and organisational support.',
    faqH2: 'Frequently asked questions about recruiting truck drivers',
    faq: [
      { q: 'Can the drivers start driving right away?', a: 'Commercial freight transport requires a valid C/CE licence and the professional driver qualification (code 95 or driver qualification card). A foreign licence usually has to be converted within six months of taking up residence. For licences from Albania, Kosovo, Montenegro, North Macedonia and Serbia – including classes C and CE – this works without a theory or practical test. We clarify what is needed in each case before hiring.' },
      { q: 'Can drivers start in a different role first?', a: 'Under certain conditions this is possible, for example working in the warehouse while the qualification is obtained. Whether this applies in your case is decided by the Federal Employment Agency. We assist with preparing the documents.' },
      { q: 'What experience do the drivers have?', a: 'We place drivers with professional experience. Driving experience, vehicle types and previous jobs are clarified in the interview and listed in the profile.' },
      { q: 'Who pays for licence conversion and Code 95?', a: 'The driver pays for the licence conversion and initial qualification. We organise and support the process.' },
      { q: 'Which countries do your drivers come from?', a: 'From the EU, the Western Balkans and Germany: drivers who already live and work in an EU country with a residence permit (often with an EU licence and Code 95), citizens of Albania, Kosovo, North Macedonia, Serbia, Montenegro and Bosnia and Herzegovina, EU citizens and drivers already living in Germany.' },
      { q: 'Can we request several drivers at once?', a: 'Yes. Tell us how many you need and we plan the selection accordingly.' },
    ],
    euEyebrow: 'Fastest route', euH2: 'Drivers with an EU licence and Code 95 – already working in the EU',
    euText: 'Many experienced CE drivers already live and work with a residence permit in Poland, Lithuania, the Netherlands or the Czech Republic and want to move to Germany.',
    euList: ['European driving experience – toll systems, driving and rest times, tachograph', 'EU licence and Code 95 are valid in Germany – no conversion needed', 'Often a faster start than candidates from outside the EU'],
    euLink: 'Information for drivers in the EU', wbLink: 'Western Balkans regulation for truck drivers',
    formH2: 'Request truck drivers',
    formText: 'Briefly describe what you need – routes, vehicle type, location. We will get back to you within 1 working day with a proposal.',
    formCall: 'Prefer email?',
  },
}[lang];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base lang={lang} page="lkw" title={c.title} description={c.description} schema={schema} stickyCta="#anfrage">
  <section class="page-hero">
    <div class="container grid-2">
      <div class="hero-copy">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1>{c.h1}</h1>
        <p class="lead">{c.lead}</p>
        <div class="btn-row">
          <a class="btn btn-accent btn-lg" href="#anfrage">{c.cta}</a>
          <a class="btn btn-ghost btn-lg" href={routes.kontakt[lang]}>{c.cta2}</a>
        </div>
        <ul class="chips">{c.areas.map((a) => <li><span class="chip">{a}</span></li>)}</ul>
      </div>
      <div class="media ratio-landscape hide-mobile-block">
        <Photo name="lkw-strasse" alt={c.alt} priority hideOnMobile sizes="(max-width: 760px) 1px, 50vw" />
      </div>
    </div>
  </section>

  <section class="section section-first">
    <div class="container">
      <div class="section-head"><p class="eyebrow">{c.servicesEyebrow}</p><h2>{c.servicesH2}</h2></div>
      <div class="grid-3">
        {c.services.map((s) => (
          <article class="card">
            <Icon name={s.icon} class="card-icon" />
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="eu-fahrer" class="section band-sand">
    <div class="container grid-2">
      <div class="stack-lg">
        <p class="eyebrow">{c.euEyebrow}</p>
        <h2>{c.euH2}</h2>
        <p class="muted">{c.euText}</p>
        <ul class="checklist">{c.euList.map((x) => <li>{x}</li>)}</ul>
        <div class="btn-row">
          <a class="btn btn-accent btn-lg" href="#anfrage">{c.cta}</a>
          <a class="link-arrow" href={routes.eufahrer[lang]}>{c.euLink}</a>
        </div>
      </div>
      <div class="stack-lg">
        <PricingBox lang={lang} heading="h3" />
        <a class="link-arrow" href={routes.westbalkan[lang]}>{c.wbLink}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2" style="align-items: stretch">
      <div class="feature-box stack-lg">
        <p class="eyebrow">{c.qualEyebrow}</p>
        <h2 class="h2-sm">{c.qualH2}</h2>
        {c.qualText.map((p) => <p class="muted">{p}</p>)}
        <p class="note">{c.note}</p>
      </div>
      <div class="feature-box feature-dark stack-lg">
        <Icon name="handshake" size={36} class="card-icon" />
        <h2 class="h2-sm">{c.directH2}</h2>
        <p>{c.directText}</p>
        <div class="btn-row"><a class="btn btn-accent btn-lg" href="#anfrage">{c.cta}</a></div>
      </div>
    </div>
  </section>

  <section id="ablauf" class="band-dark section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{c.procEyebrow}</p>
        <h2>{c.procH2}</h2>
      </div>
      <Steps lang={lang} steps={c.steps} />
      <p class="timing">{c.timing}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="section-head"><h2>{c.faqH2}</h2></div>
      <Faq items={c.faq} />
    </div>
  </section>

  <section id="anfrage" class="section band-sand">
    <div class="container form-layout">
      <div class="stack-lg">
        <h2>{c.formH2}</h2>
        <p class="muted">{c.formText}</p>
        <p><strong>{c.formCall}</strong><br /><a class="big-phone" href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <EmployerForm lang={lang} variant="lkw" />
    </div>
  </section>

</Base>
