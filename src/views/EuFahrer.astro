---
// Main landing page for truck drivers who already live and work legally in another EU country.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Faq from '../components/Faq.astro';
import Flags from '../components/Flags.astro';
import CandidateForm from '../components/CandidateForm.astro';
import { routes, type Lang } from '../i18n';
import { site, sampleJobs } from '../config';
import { jobPostingSchema } from '../lib/jobs';
interface Props { lang: Lang }
const { lang } = Astro.props;
const r = (k: keyof typeof routes) => routes[k][lang];

const c = {
  de: {
    title: 'LKW-Fahrer Wechsel nach Deutschland – für Fahrer mit Aufenthalt in der EU | SION Consulting',
    description: 'LKW-Fahrer Wechsel nach Deutschland: kostenlos für Fahrer · direkte Anstellung · keine Zeitarbeit · für Fahrer mit Aufenthalt in der EU, Führerschein C/CE und Code 95.',
    eyebrow: 'Für LKW-Fahrer, die schon in der EU leben',
    h1: 'Sie fahren schon in der EU? Wechseln Sie zu einem LKW-Job in Deutschland.',
    whoTitle: 'Das ist für Sie, wenn Sie …',
    who: [
      'legal in einem EU-Land leben und arbeiten (z. B. Polen, Litauen, Niederlande, Tschechien) – mit Aufenthaltstitel',
      'einen Führerschein C/CE und Code 95 haben',
      'mehr verdienen, feste Touren fahren und in Deutschland leben möchten',
    ],
    cta: 'In 1 Minute bewerben', cta2: 'Beispiel-Jobs ansehen',
    free: 'Kostenlos für Fahrer – wir nehmen niemals Geld von Fahrern.',
    flagsLabel: 'Von Polen, Litauen, Lettland, den Niederlanden, Tschechien, der Slowakei, Ungarn, Rumänien, Kroatien oder Slowenien nach Deutschland',
    alt: 'LKW-Fahrer Wechsel nach Deutschland: Sattelzug auf einer deutschen Landstraße',
    whyEyebrow: 'Warum Deutschland, warum wir',
    whyH2: 'Was Sie als LKW-Fahrer in Deutschland erwartet',
    why: [
      ['handshake', 'Festanstellung beim Arbeitgeber', 'Unbefristeter Vertrag direkt beim Arbeitgeber – keine Zeitarbeit.'],
      ['award', 'Deutscher Lohn', 'Deutscher Lohn, Spesen und deutsche Sozialversicherung.'],
      ['clock', 'Feste Touren', 'Nahverkehr – jeden Tag zu Hause möglich – oder Fernverkehr.'],
      ['pin', 'Wohnung oder WG', 'Wir helfen bei der Suche nach einer Wohnung oder einem WG-Zimmer.'],
      ['check', 'Kostenlos für Fahrer', 'Sie zahlen nichts. Der Arbeitgeber zahlt unsere Vermittlung.'],
    ],
    stepsEyebrow: 'Ablauf', stepsH2: 'In 5 Schritten zum LKW-Job in Deutschland',
    steps: [
      ['Bewerben', 'Das Formular dauert 1 Minute.'],
      ['Wir prüfen', 'Aufenthaltstitel, Führerschein und Code 95.'],
      ['Video-Gespräch', 'Sie sprechen per Video mit dem Arbeitgeber.'],
      ['Unterlagen', 'Wir helfen bei den Unterlagen für Arbeits- und Aufenthaltserlaubnis in Deutschland.'],
      ['Start in Deutschland', 'Sie beginnen bei Ihrem neuen Arbeitgeber.'],
    ] as [string, string][],
    timing: 'Wie lange dauert es? Das hängt von Ihrem Fall ab – oft einige Wochen bis wenige Monate. Wir prüfen Ihren Fall individuell; die Entscheidung treffen die Behörden.',
    needH2: 'Was Sie mitbringen',
    need: [
      'Gültiger Aufenthaltstitel in einem EU-Land (z. B. karta pobytu, leidimas gyventi, verblijfsvergunning …)',
      'Führerschein C/CE (EU-Führerschein bevorzugt) mit Code 95',
      'Mindestens 1 Jahr Erfahrung als LKW-Fahrer',
      'Sauberes Führungszeugnis',
      'Deutschkenntnisse sind ein Plus – nicht für jeden Job nötig',
    ],
    freeH: 'Kostenlos für Fahrer',
    freeP: 'Wir verlangen niemals Geld von Bewerberinnen und Bewerbern. Wenn jemand in unserem Namen Geld verlangt, melden Sie es uns.',
    jobsEyebrow: 'Beispiel-Jobs', jobsH2: 'Aktuelle LKW-Fahrer-Jobs in Deutschland',
    jobsText: 'Beispiele für offene Stellen bei unseren Arbeitgebern. Den Namen des Arbeitgebers nennen wir im Gespräch.',
    pay: 'Gehalt', payOpen: 'Gehalt auf Anfrage', perMonth: '€ brutto/Monat', housing: 'Wohnung/WG möglich', applyJob: 'Für diesen Job bewerben',
    faqH2: 'Häufige Fragen von LKW-Fahrern aus der EU',
    faq: [
      { q: 'Ich habe einen Aufenthaltstitel in Polen oder Litauen – kann ich in Deutschland arbeiten?', a: 'Oft ja, aber es hängt von Ihrem Aufenthaltstitel und Ihrer Staatsangehörigkeit ab. Wir prüfen Ihre Unterlagen und erklären die nächsten Schritte; die Entscheidung treffen die deutschen Behörden.' },
      { q: 'Gilt mein EU-Führerschein in Deutschland?', a: 'Ja, ein EU-Führerschein und Code 95 gelten in Deutschland.' },
      { q: 'Muss ich etwas bezahlen?', a: 'Nein. Wir nehmen niemals Geld von Fahrern.' },
      { q: 'Muss ich Deutsch sprechen?', a: 'Nicht für jeden Job. Deutsch hilft aber.' },
    ],
    formEyebrow: 'Bewerbung', formH2: 'Jetzt als LKW-Fahrer bewerben',
    formText: 'Zuerst zwei Fragen zu Staatsangehörigkeit und Wohnland. Dann Ihre Daten – fertig in etwa einer Minute.',
    note: 'Wir unterstützen bei administrativen Schritten; eine Rechtsberatung bieten wir nicht an. Verbindlich entscheiden die zuständigen Behörden.',
    otherH: 'Sie leben nicht in der EU?',
    otherP: 'Wir vermitteln auch Staatsangehörige aus Albanien, Kosovo, Nordmazedonien, Serbien, Montenegro sowie Bosnien und Herzegowina.',
    otherLink: 'Alle Informationen für Bewerber',
  },
  en: {
    title: 'Truck Driver Jobs in Germany for EU Residence Permit Holders | SION Consulting',
    description: 'Truck driver jobs in Germany for drivers with an EU residence permit: free for drivers · direct employment · no temporary agency · for drivers living in the EU with C/CE and Code 95.',
    eyebrow: 'For truck drivers who live in the EU',
    h1: 'Already driving in the EU? Move to a truck job in Germany.',
    whoTitle: 'This is for you if you …',
    who: [
      'live and work legally in an EU country (e.g. Poland, Lithuania, Netherlands, Czech Republic) with a residence permit',
      'have a driving licence C/CE and Code 95',
      'want better pay, fixed routes and to live in Germany',
    ],
    cta: 'Apply in 1 minute', cta2: 'See sample jobs',
    free: 'Free for drivers. We never take money from drivers.',
    flagsLabel: 'From Poland, Lithuania, Latvia, the Netherlands, Czech Republic, Slovakia, Hungary, Romania, Croatia or Slovenia to Germany',
    alt: 'Truck driver jobs in Germany with an EU residence permit: semi-trailer truck on a German road',
    whyEyebrow: 'Why Germany, why us',
    whyH2: 'What you get as a truck driver in Germany',
    why: [
      ['handshake', 'Permanent contract', 'A permanent contract directly with the employer. No temporary agency.'],
      ['award', 'German pay', 'German wages, daily allowances (Spesen) and German social security.'],
      ['clock', 'Fixed routes', 'Regional work – home every day is possible – or long-haul.'],
      ['pin', 'Apartment or shared flat', 'We help you find an apartment or a room in a shared flat.'],
      ['check', 'Free for drivers', 'You pay nothing. The employer pays for our service.'],
    ],
    stepsEyebrow: 'How it works', stepsH2: '5 steps to your truck job in Germany',
    steps: [
      ['Apply', 'The form takes 1 minute.'],
      ['We check', 'Your residence permit, licence and Code 95.'],
      ['Video interview', 'You talk to the employer by video.'],
      ['Paperwork', 'We help with the papers for the German work and residence permit.'],
      ['Start in Germany', 'You start with your new employer.'],
    ] as [string, string][],
    timing: 'How long does it take? It depends on your case – often a few weeks to a few months. We check your case individually; the decision is made by the German authorities.',
    needH2: 'What you need',
    need: [
      'A valid residence permit in an EU country (e.g. karta pobytu, leidimas gyventi, verblijfsvergunning …)',
      'Driving licence C/CE (EU licence preferred) with Code 95',
      'At least 1 year of experience as a truck driver',
      'A clean criminal record',
      'Basic German is a plus. It is not needed for every job.',
    ],
    freeH: 'Free for drivers',
    freeP: 'We never ask applicants for money. If someone asks you for money in our name, please tell us.',
    jobsEyebrow: 'Sample jobs', jobsH2: 'Truck driver jobs in Germany now',
    jobsText: 'Examples of open jobs with our employers. We tell you the employer’s name in the interview.',
    pay: 'Pay', payOpen: 'Pay on request', perMonth: '€ gross/month', housing: 'Apartment/shared flat possible', applyJob: 'Apply for this job',
    faqH2: 'Questions from truck drivers in the EU',
    faq: [
      { q: 'I have a residence permit in Poland or Lithuania. Can I work in Germany?', a: 'Often yes, but it depends on your permit and nationality. We check your documents and explain the next steps; the decision is made by the German authorities.' },
      { q: 'Is my EU driving licence valid in Germany?', a: 'Yes, an EU licence and Code 95 are valid in Germany.' },
      { q: 'Do I have to pay?', a: 'No. We never take money from drivers.' },
      { q: 'Do I need German?', a: 'Not for every job. It helps.' },
    ],
    formEyebrow: 'Apply', formH2: 'Apply as a truck driver now',
    formText: 'First two questions about your citizenship and the country you live in. Then your details. It takes about one minute.',
    note: 'We help with administrative steps. We do not give legal advice. The competent authorities make the binding decision.',
    otherH: 'You do not live in the EU?',
    otherP: 'We also place citizens of Albania, Kosovo, North Macedonia, Serbia, Montenegro and Bosnia and Herzegovina.',
    otherLink: 'All information for applicants',
  },
}[lang];

const pageUrl = new URL(r('eufahrer'), site.url).href;
const fmt = (n: number) => n.toLocaleString(lang === 'de' ? 'de-DE' : 'en-GB');
const schema = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  ...sampleJobs.map((j) => jobPostingSchema(j, lang, pageUrl)),
];
---
<Base lang={lang} page="eufahrer" title={c.title} description={c.description} schema={schema} audience="candidate">
  <section class="page-hero">
    <div class="container grid-2">
      <div class="hero-copy">
        <p class="eyebrow">{c.eyebrow}</p>
        <h1>{c.h1}</h1>
        <div class="who-box">
          <p class="who-title"><Icon name="check" size={24} /> {c.whoTitle}</p>
          <ul class="checklist checklist-green">{c.who.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="btn-row">
          <a class="btn btn-accent btn-lg" href="#bewerbung">{c.cta}</a>
          <a class="btn btn-ghost btn-lg" href="#jobs">{c.cta2}</a>
        </div>
        <p class="free-note">{c.free}</p>
      </div>
      <div class="stack-lg">
        <div class="media ratio-landscape hide-mobile-block">
          <Photo name="lkw-strasse" alt={c.alt} priority hideOnMobile sizes="(max-width: 760px) 1px, 50vw" />
        </div>
        <Flags lang={lang} label={c.flagsLabel} />
      </div>
    </div>
  </section>

  <section class="section section-first">
    <div class="container">
      <div class="section-head"><p class="eyebrow">{c.whyEyebrow}</p><h2>{c.whyH2}</h2></div>
      <div class="grid-3">
        {c.why.map(([icon, h, p]) => (
          <article class="card"><Icon name={icon} class="card-icon" /><h3>{h}</h3><p>{p}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="band-dark section">
    <div class="container">
      <div class="section-head"><p class="eyebrow">{c.stepsEyebrow}</p><h2>{c.stepsH2}</h2></div>
      <ol class="steps steps-5">{c.steps.map(([h, p]) => <li><h3>{h}</h3><p>{p}</p></li>)}</ol>
      <p class="timing">{c.timing}</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2" style="align-items: start">
      <div class="card">
        <h2 class="h2-sm">{c.needH2}</h2>
        <ul class="checklist">{c.need.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="stack-lg">
        <div class="free-box">
          <Icon name="shield" size={30} />
          <div><strong>{c.freeH}</strong><p>{c.freeP}</p></div>
        </div>
        <p class="note">{c.note}</p>
      </div>
    </div>
  </section>

  <section id="jobs" class="section band-soft">
    <div class="container">
      <div class="section-head"><p class="eyebrow">{c.jobsEyebrow}</p><h2>{c.jobsH2}</h2><p class="muted">{c.jobsText}</p></div>
      <div class="job-grid">
        {sampleJobs.map((j) => (
          <article class="job-card" id={`job-${j.id}`}>
            <h3>{j.title[lang]}</h3>
            <ul class="job-meta">
              <li><Icon name="pin" size={14} /> {j.region[lang]}</li>
              {j.tags.map((tag) => <li>{tag[lang]}</li>)}
              {j.housing && <li class="housing">{c.housing}</li>}
            </ul>
            <p class="job-pay">{j.salaryMin > 0 ? `${c.pay}: ${fmt(j.salaryMin)}${j.salaryMax > 0 ? `–${fmt(j.salaryMax)}` : '+'} ${c.perMonth}` : c.payOpen}</p>
            <p>{j.text[lang]}</p>
            <a class="link-arrow" href="#bewerbung">{c.applyJob}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="section-head"><h2>{c.faqH2}</h2></div>
      <Faq items={c.faq} />
    </div>
  </section>

  <section id="bewerbung" class="section band-sand">
    <div class="container form-layout">
      <div class="stack-lg">
        <p class="eyebrow">{c.formEyebrow}</p>
        <h2>{c.formH2}</h2>
        <p class="muted">{c.formText}</p>
        <div class="free-box"><Icon name="shield" size={26} /><div><strong>{c.freeH}</strong><p>{c.freeP}</p></div></div>
        <p class="note">{c.note}</p>
        <div class="stack">
          <h3>{c.otherH}</h3>
          <p class="muted">{c.otherP}</p>
          <a class="link-arrow" href={r('bewerber')}>{c.otherLink}</a>
        </div>
      </div>
      <CandidateForm lang={lang} preset="eu" job="LKW" />
    </div>
  </section>
</Base>
