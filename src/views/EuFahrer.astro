---
// Landing page for truck drivers WITHOUT an EU passport who already live and drive in another EU country.
// Copy: "Implementation Brief – sionconsulting.de Driver Pages" (8 Nov 2026), section 5 – German master, English translated.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Faq from '../components/Faq.astro';
import Flags from '../components/Flags.astro';
import CandidateForm from '../components/CandidateForm.astro';
import { routes, type Lang } from '../i18n';
import { site, sampleJobs, showSampleJobs } from '../config';
import { jobPostingSchema } from '../lib/jobs';
import { photoFor } from '../lib/photos';
interface Props { lang: Lang }
const { lang } = Astro.props;
const r = (k: keyof typeof routes) => routes[k][lang];

const c = {
  de: {
    title: 'Mit EU-Aufenthaltstitel als LKW-Fahrer nach Deutschland',
    description: 'Kein EU-Pass, aber Aufenthaltstitel und CE-Job in Polen, Litauen & Co.? Wechseln Sie in eine Festanstellung in Deutschland – kostenlos, mit Visum-Hilfe.',
    kicker: 'Für LKW-Fahrer ohne EU-Pass, die schon in der EU fahren',
    h1: 'LKW-Fahrer Job in Deutschland – für Fahrer ohne EU-Pass, die schon in der EU fahren',
    lead: 'Sie leben mit Aufenthaltstitel in Polen, Litauen, Tschechien oder einem anderen EU-Land und fahren dort CE? Wir vermitteln Sie in eine Festanstellung direkt bei einem deutschen Transportunternehmen – und helfen beim Visum.',
    chips: ['Kostenlos für Fahrer', 'Festanstellung, keine Zeitarbeit', 'Hilfe bei Visum und Unterlagen'],
    cta: 'In 1 Minute bewerben', ctaContact: 'Fragen? Kontakt für Fahrer',
    alt: 'Orangefarbene Volvo-Sattelzugmaschine mit Frontlenker-Kabine und weißem Auflieger in Fahrt auf einer Straße',
    whoH2: 'Ist das für Sie?',
    whoIntro: 'Diese Seite ist für Sie, wenn Sie …',
    who: [
      'keinen EU-Pass haben (z. B. aus der Ukraine, Belarus, Usbekistan, Kasachstan, Georgien, Moldau, Indien oder den Philippinen),',
      'mit gültigem Aufenthaltstitel in einem EU-Land leben (z. B. karta pobytu, leidimas gyventi, povolení k pobytu),',
      'einen EU-Führerschein C/CE mit Code 95 haben,',
      'mindestens 1 Jahr als LKW-Fahrer gearbeitet haben.',
    ],
    otherLink: 'EU-Bürger oder aus dem Westbalkan? Hier entlang',
    expectH2: 'Was Sie in Deutschland erwartet',
    expect: [
      ['handshake', 'Festanstellung beim Arbeitgeber', 'Sie arbeiten direkt beim deutschen Unternehmen, nicht über Zeitarbeit.'],
      ['doc', 'Deutscher Arbeitsvertrag', 'Deutscher Lohn, Spesen und deutsche Sozialversicherung.'],
      ['clock', 'Feste Touren', 'Nahverkehr mit Feierabend zu Hause oder Fernverkehr, je nach Stelle.'],
      ['users', 'Familie', 'Mit dem Aufenthaltstitel für Berufskraftfahrer ist Familiennachzug grundsätzlich möglich.'],
      ['pin', 'Hilfe beim Start', 'Wir unterstützen bei Anmeldung, Wohnungssuche und Unterlagen.'],
    ],
    stepsH2: 'So kommen Sie nach Deutschland',
    steps: [
      ['Bewerben', 'Formular, etwa 1 Minute.'],
      ['Prüfung', 'Wir prüfen Aufenthaltstitel, Führerschein und Code 95.'],
      ['Video-Gespräch', 'Sie sprechen mit dem Arbeitgeber.'],
      ['Arbeitsvertrag', 'Sie erhalten ein konkretes Jobangebot.'],
      ['Zustimmung der Arbeitsagentur', 'Der Arbeitgeber beantragt sie nach § 24a BeschV. Die Agentur prüft, ob Lohn und Bedingungen fair sind.'],
      ['Visum', 'Sie beantragen es bei der deutschen Botschaft in Ihrem Wohnland (Aufenthaltstitel nach § 19c Abs. 1 AufenthG). Oft geht das beschleunigte Fachkräfteverfahren.'],
      ['Start in Deutschland', 'Anmeldung, Arbeitsbeginn.'],
    ] as [string, string][],
    timing: 'Wie lange dauert es? Meist einige Wochen bis wenige Monate, je nach Botschaft. Die Entscheidung treffen die Behörden.',
    docsH2: 'Diese Unterlagen brauchen Sie',
    docs: ['Reisepass', 'Aufenthaltstitel im EU-Land (gültig)', 'EU-Führerschein C/CE mit Code 95', 'Fahrerkarte', 'Lebenslauf mit Ihren Fahrerjobs', 'Arbeitsbescheinigungen, wenn vorhanden'],
    freeH: 'Kostenlos für Fahrer',
    freeP: 'Wir verlangen niemals Geld von Fahrern. Der Arbeitgeber bezahlt unsere Vermittlung. Wenn jemand in unserem Namen Geld verlangt, melden Sie es uns:',
    faqH2: 'Häufige Fragen',
    faq: [
      { q: 'Ich habe eine karta pobytu in Polen. Darf ich in Deutschland als LKW-Fahrer arbeiten?', a: 'Ja, wenn Sie einen EU-Führerschein C/CE mit Code 95 und ein Jobangebot aus Deutschland haben. Der Arbeitgeber holt die Zustimmung der Bundesagentur für Arbeit ein, Sie beantragen das Visum. Wir bereiten die Unterlagen mit Ihnen vor.' },
      { q: 'Kann ich mit meinem polnischen oder litauischen Aufenthaltstitel einfach in Deutschland anfangen?', a: 'Nein. Für eine feste Stelle in Deutschland brauchen Sie einen deutschen Aufenthaltstitel. Für Berufskraftfahrer ist das Verfahren aber speziell geregelt (§ 24a BeschV) und gut machbar.' },
      { q: 'Gilt mein Führerschein mit Code 95 in Deutschland?', a: 'Ein EU-Führerschein gilt in Deutschland, und Code 95 aus einem EU-Land wird anerkannt. Die Weiterbildung alle 5 Jahre machen Sie dann in Deutschland.' },
      { q: 'Muss ich Deutsch sprechen?', a: 'Nicht für jede Stelle. Viele Arbeitgeber akzeptieren Englisch oder Grundkenntnisse. Deutsch ist ein Plus.' },
      { q: 'Wie lange dauert es?', a: 'Meist einige Wochen bis wenige Monate, je nach Botschaft in Ihrem Wohnland.' },
      { q: 'Was kostet das für mich?', a: 'Nichts. Der Arbeitgeber bezahlt uns.' },
      { q: 'Kann meine Familie mitkommen?', a: 'Grundsätzlich ja, über den Familiennachzug. Die Voraussetzungen prüft die Botschaft.' },
    ],
    // FAQPage JSON-LD exactly as in the brief (section 7)
    faqSchema: [
      ['Ich habe eine karta pobytu in Polen. Darf ich in Deutschland als LKW-Fahrer arbeiten?', 'Ja, wenn Sie einen EU-Führerschein C/CE mit Code 95 und ein Jobangebot aus Deutschland haben. Der Arbeitgeber holt die Zustimmung der Bundesagentur für Arbeit ein, Sie beantragen das Visum.'],
      ['Kann ich mit meinem polnischen oder litauischen Aufenthaltstitel einfach in Deutschland anfangen?', 'Nein. Für eine feste Stelle in Deutschland brauchen Sie einen deutschen Aufenthaltstitel. Für Berufskraftfahrer ist das Verfahren nach § 24a BeschV speziell geregelt.'],
      ['Gilt mein Führerschein mit Code 95 in Deutschland?', 'Ein EU-Führerschein gilt in Deutschland, und Code 95 aus einem EU-Land wird anerkannt. Die Weiterbildung alle 5 Jahre machen Sie dann in Deutschland.'],
      ['Muss ich Deutsch sprechen?', 'Nicht für jede Stelle. Viele Arbeitgeber akzeptieren Englisch oder Grundkenntnisse.'],
      ['Wie lange dauert es?', 'Meist einige Wochen bis wenige Monate, je nach Botschaft in Ihrem Wohnland.'],
      ['Was kostet das für mich?', 'Nichts. Der Arbeitgeber bezahlt uns.'],
      ['Kann meine Familie mitkommen?', 'Grundsätzlich ja, über den Familiennachzug. Die Voraussetzungen prüft die Botschaft.'],
    ],
    disclaimer: 'Wir unterstützen bei administrativen Schritten; eine Rechtsberatung bieten wir nicht an. Verbindlich entscheiden die zuständigen Behörden.',
    formH2: 'Jetzt bewerben',
    jobsEyebrow: 'Beispiel-Jobs', jobsH2: 'Aktuelle LKW-Fahrer-Jobs in Deutschland', jobsText: 'Beispiele für offene Stellen bei unseren Arbeitgebern.',
    pay: 'Gehalt', payOpen: 'Gehalt auf Anfrage', perMonth: '€ brutto/Monat', housing: 'Wohnung/WG möglich', applyJob: 'Für diesen Job bewerben',
  },
  en: {
    title: 'Non-EU Truck Drivers in the EU: Move to a Job in Germany',
    description: 'Non-EU citizen driving CE in Poland, Lithuania or elsewhere in the EU? Move to a permanent job in Germany. Free for drivers, with visa help.',
    kicker: 'For truck drivers without an EU passport who already drive in the EU',
    h1: 'Truck driver job in Germany – for drivers without an EU passport who already drive in the EU',
    lead: 'You live with a residence permit in Poland, Lithuania, the Czech Republic or another EU country and drive CE there? We place you in a permanent job directly with a German transport company – and help with the visa.',
    chips: ['Free for drivers', 'Permanent job, no temporary agency', 'Help with visa and documents'],
    cta: 'Apply in 1 minute', ctaContact: 'Questions? Contact for drivers',
    alt: 'Orange Volvo cab-over tractor unit with a white trailer driving on a road',
    whoH2: 'Is this for you?',
    whoIntro: 'This page is for you if you …',
    who: [
      'do not have an EU passport (e.g. from Ukraine, Belarus, Uzbekistan, Kazakhstan, Georgia, Moldova, India or the Philippines),',
      'live in an EU country with a valid residence permit (e.g. karta pobytu, leidimas gyventi, povolení k pobytu),',
      'have an EU driving licence C/CE with Code 95,',
      'have worked as a truck driver for at least 1 year.',
    ],
    otherLink: 'EU citizen or from the Western Balkans? Go here',
    expectH2: 'What you can expect in Germany',
    expect: [
      ['handshake', 'Permanent job with the employer', 'You work directly for the German company, not through a temporary agency.'],
      ['doc', 'German employment contract', 'German wages, daily allowances (Spesen) and German social security.'],
      ['clock', 'Fixed routes', 'Regional work with evenings at home, or long-haul – depending on the job.'],
      ['users', 'Family', 'With the residence permit for professional drivers, family reunification is generally possible.'],
      ['pin', 'Help with the start', 'We help with registration, finding a flat and paperwork.'],
    ],
    stepsH2: 'How you get to Germany',
    steps: [
      ['Apply', 'Form, about 1 minute.'],
      ['Check', 'We check your residence permit, licence and Code 95.'],
      ['Video interview', 'You talk to the employer.'],
      ['Employment contract', 'You get a concrete job offer.'],
      ['Approval of the employment agency', 'The employer applies for it under Section 24a BeschV. The agency checks that pay and conditions are fair.'],
      ['Visa', 'You apply at the German embassy in your country of residence (residence permit under Section 19c(1) AufenthG). The accelerated skilled worker procedure is often possible.'],
      ['Start in Germany', 'Registration, first working day.'],
    ] as [string, string][],
    timing: 'How long does it take? Usually a few weeks to a few months, depending on the embassy. The authorities make the decision.',
    docsH2: 'Documents you need',
    docs: ['Passport', 'Residence permit in the EU country (valid)', 'EU driving licence C/CE with Code 95', 'Driver card (tachograph card)', 'CV with your driving jobs', 'Employment certificates, if you have them'],
    freeH: 'Free for drivers',
    freeP: 'We never ask drivers for money. The employer pays for our service. If someone asks you for money in our name, please tell us:',
    faqH2: 'Frequently asked questions',
    faq: [
      { q: 'I have a karta pobytu in Poland. Can I work in Germany as a truck driver?', a: 'Yes, if you have an EU driving licence C/CE with Code 95 and a job offer from Germany. The employer gets the approval of the Federal Employment Agency, you apply for the visa. We prepare the documents with you.' },
      { q: 'Can I simply start working in Germany with my Polish or Lithuanian residence permit?', a: 'No. For a permanent job in Germany you need a German residence permit. For professional drivers, however, the procedure has its own rules (Section 24a BeschV) and is very doable.' },
      { q: 'Is my licence with Code 95 valid in Germany?', a: 'An EU driving licence is valid in Germany, and Code 95 from an EU country is recognised. You then do the further training every 5 years in Germany.' },
      { q: 'Do I need to speak German?', a: 'Not for every job. Many employers accept English or basic German. German is a plus.' },
      { q: 'How long does it take?', a: 'Usually a few weeks to a few months, depending on the embassy in your country of residence.' },
      { q: 'What does it cost me?', a: 'Nothing. The employer pays us.' },
      { q: 'Can my family come with me?', a: 'Generally yes, through family reunification. The embassy checks the requirements.' },
    ],
    faqSchema: [
      ['I have a karta pobytu in Poland. Can I work in Germany as a truck driver?', 'Yes, if you have an EU driving licence C/CE with Code 95 and a job offer from Germany. The employer gets the approval of the Federal Employment Agency, you apply for the visa.'],
      ['Can I simply start working in Germany with my Polish or Lithuanian residence permit?', 'No. For a permanent job in Germany you need a German residence permit. For professional drivers, the procedure has its own rules under Section 24a BeschV.'],
      ['Is my licence with Code 95 valid in Germany?', 'An EU driving licence is valid in Germany, and Code 95 from an EU country is recognised. You then do the further training every 5 years in Germany.'],
      ['Do I need to speak German?', 'Not for every job. Many employers accept English or basic German.'],
      ['How long does it take?', 'Usually a few weeks to a few months, depending on the embassy in your country of residence.'],
      ['What does it cost me?', 'Nothing. The employer pays us.'],
      ['Can my family come with me?', 'Generally yes, through family reunification. The embassy checks the requirements.'],
    ],
    disclaimer: 'We help with administrative steps; we do not give legal advice. The competent authorities make the binding decision.',
    formH2: 'Apply now',
    jobsEyebrow: 'Sample jobs', jobsH2: 'Truck driver jobs in Germany now', jobsText: 'Examples of open jobs with our employers.',
    pay: 'Pay', payOpen: 'Pay on request', perMonth: '€ gross/month', housing: 'Apartment/shared flat possible', applyJob: 'Apply for this job',
  },
}[lang];

const jobs = showSampleJobs ? sampleJobs : [];
const pageUrl = new URL(r('eufahrer'), site.url).href;
const fmt = (n: number) => n.toLocaleString(lang === 'de' ? 'de-DE' : 'en-GB');
const heroPhoto = photoFor('lkw-eu') ? 'lkw-eu' : 'lkw-strasse';
const schema = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqSchema.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ...jobs.map((j) => jobPostingSchema(j, lang, pageUrl)),
];
---
<Base lang={lang} page="eufahrer" title={c.title} description={c.description} schema={schema} audience="candidate" layout="driver">
  <section class="page-hero">
    <div class="container grid-2">
      <div class="hero-copy">
        <p class="eyebrow">{c.kicker}</p>
        <h1>{c.h1}</h1>
        <p class="lead">{c.lead}</p>
        <ul class="hero-chips">{c.chips.map((x) => <li><Icon name="check" size={16} />{x}</li>)}</ul>
        <div class="btn-row">
          <a class="btn btn-accent btn-lg" href="#bewerbung">{c.cta}</a>
          <a class="link-arrow" href={r('kontaktFahrer')}>{c.ctaContact}</a>
        </div>
      </div>
      <div class="media ratio-landscape hide-mobile-block">
        <Photo name={heroPhoto} alt={c.alt} priority hideOnMobile sizes="(max-width: 760px) 1px, 50vw" />
      </div>
    </div>
  </section>

  <section class="section section-first">
    <div class="container grid-2" style="align-items: start">
      <div class="who-box">
        <h2 class="h2-sm">{c.whoH2}</h2>
        <p>{c.whoIntro}</p>
        <ul class="checklist checklist-green">{c.who.map((x) => <li>{x}</li>)}</ul>
        <p><a class="link-arrow" href={r('bewerber')}>{c.otherLink}</a></p>
      </div>
      <Flags lang={lang} />
    </div>
  </section>

  <section class="section band-soft">
    <div class="container">
      <div class="section-head"><h2>{c.expectH2}</h2></div>
      <div class="grid-3">
        {c.expect.map(([icon, h, p]) => (
          <article class="card"><Icon name={icon} class="card-icon" /><h3>{h}</h3><p>{p}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="band-dark section">
    <div class="container">
      <div class="section-head"><h2>{c.stepsH2}</h2></div>
      <ol class="steps steps-5">{c.steps.map(([h, p]) => <li><h3>{h}</h3><p>{p}</p></li>)}</ol>
      <p class="timing">{c.timing}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="card">
        <h2 class="h2-sm">{c.docsH2}</h2>
        <ul class="checklist">{c.docs.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  {jobs.length > 0 && <section id="jobs" class="section band-soft">
    <div class="container">
      <div class="section-head"><p class="eyebrow">{c.jobsEyebrow}</p><h2>{c.jobsH2}</h2><p class="muted">{c.jobsText}</p></div>
      <div class="job-grid">
        {jobs.map((j) => (
          <article class="job-card" id={`job-${j.id}`}>
            <h3>{j.title[lang]}</h3>
            <ul class="job-meta">
              <li><Icon name="pin" size={14} /> {j.region[lang]}</li>
              {j.tags.map((tag) => <li>{tag[lang]}</li>)}
              {j.housing && <li class="housing">{c.housing}</li>}
            </ul>
            <p class="job-pay">{j.salaryMin > 0 ? `${c.pay}: ${fmt(j.salaryMin)}${j.salaryMax > 0 ? `–${fmt(j.salaryMax)}` : '+'} ${c.perMonth}` : c.payOpen}</p>
            <p>{j.text[lang]}</p>
            <a class="link-arrow" href="#bewerbung">{c.applyJob}</a>
          </article>
        ))}
      </div>
    </div>
  </section>}

  <section id="faq" class="section" style="padding-top: 0">
    <div class="container narrow">
      <div class="section-head"><h2>{c.faqH2}</h2></div>
      <Faq items={c.faq} />
      <p class="note" style="margin-top: 24px">{c.disclaimer}</p>
    </div>
  </section>

  <section id="bewerbung" class="section band-sand">
    <div class="container form-layout">
      <div class="stack-lg">
        <h2>{c.formH2}</h2>
        <div class="free-box">
          <Icon name="shield" size={26} />
          <div><strong>{c.freeH}</strong><p>{c.freeP} <a href={`mailto:${site.applicationEmail}`}>{site.applicationEmail}</a></p></div>
        </div>
      </div>
      <CandidateForm lang={lang} preset="eu" job="LKW" variant="driver" />
    </div>
  </section>
</Base>
