---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Steps from '../components/Steps.astro';
import Trust from '../components/Trust.astro';
import CtaBand from '../components/CtaBand.astro';
import PricingBox from '../components/PricingBox.astro';
import { routes, ui, requestHref, type Lang } from '../i18n';
import { site } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const r = (k: keyof typeof routes) => routes[k][lang];

const c = {
  de: {
    title: 'Personalvermittlung für LKW-Fahrer & Logistik | SION',
    description: 'LKW-Fahrer, Paketzusteller, Lager- und Reinigungspersonal für Unternehmen in Deutschland – plus Back Office. Keine Anzahlung, Zahlung nach 30 Tagen.',
    h1: 'Qualifizierte LKW-Fahrer und Logistikmitarbeiter für Ihr Unternehmen',
    lead: 'Wir vermitteln vorgeprüfte Arbeitskräfte aus Deutschland, der EU und dem Westbalkan – mit direkter Anstellung und persönlicher Betreuung bis zum Arbeitsbeginn.',
    lead2: 'Zusätzlich entlasten wir Ihre Verwaltung mit Back-Office-Services.',
    heroCta: 'Jetzt Personal anfragen', heroCta2: 'Ich suche einen Job',
    procSteps: [['Personalbedarf mitteilen', 'Sie nennen Position, Anzahl, Einsatzort und Starttermin – per Formular oder im Gespräch.'], ['Kandidaten suchen und vorprüfen', 'Wir suchen passende Bewerber und prüfen Erfahrung, Führerschein und Unterlagen.'], ['Bewerber kennenlernen und auswählen', 'Sie führen die Gespräche – vor Ort oder per Video – und entscheiden selbst.'], ['Einstellung und Arbeitsbeginn', 'Wir unterstützen bei Unterlagen und Organisation bis zum ersten Arbeitstag.']] as [string, string][],
    chips: [['LKW-Fahrer', r('lkw')], ['Paketzusteller', r('paket')], ['Lager & Logistik', r('lager')], ['Reinigung', r('reinigung')], ['Saisonarbeit', r('saison')], ['Back Office', r('backoffice')]],
    chipsLabel: 'Unsere Bereiche',
    services: 'Unsere Leistungen',
    callNow: 'Jetzt anrufen:',
    heroAlt: 'LKW-Fahrer vor seinem Sattelzug',
    cardTitle: 'Ihr Vorteil',
    cardList: ['Vorgeprüfte Kandidaten', 'Direkte Anstellung in Ihrem Unternehmen', 'Ein deutschsprachiger Ansprechpartner'],
    svcEyebrow: 'Personalvermittlung',
    svcH2: 'Personal für Transport, Logistik und Dienstleistung',
    svcLead: 'Personalmangel, offene Fahrerstellen, erfolglose Stellenanzeigen? Wir finden passende Mitarbeiter aus der EU, dem Westbalkan und Deutschland und begleiten den Prozess bis zum ersten Arbeitstag.',
    svcAll: 'Alle Leistungen der Personalvermittlung',
    lkwEyebrow: 'Schwerpunkt',
    lkwH2: 'LKW-Fahrer aus der EU, dem Westbalkan und Deutschland – für Ihr Transportunternehmen',
    lkwText: 'Der Fahrermangel bremst Speditionen in ganz Deutschland. Wir rekrutieren erfahrene CE-Fahrer – vor allem Fahrer, die bereits mit EU-Führerschein und Code 95 in der EU fahren –, prüfen sie vorab und unterstützen bei allen administrativen Schritten – bis der Fahrer bei Ihnen im Einsatz ist.',
    lkwList: ['CE-Fahrer mit Berufserfahrung', 'Vorauswahl und Vorstellungsgespräch mit Ihnen', 'Unterstützung bei Führerscheinumschreibung und Code 95', 'Direkte Anstellung bei Ihnen – keine Arbeitnehmerüberlassung'],
    lkwCta: 'LKW-Fahrer anfragen', lkwCta2: 'Kostenloses Erstgespräch',
    lkwAlt: 'Weißer LKW auf der Landstraße bei Sonnenuntergang',
    boEyebrow: 'Zweites Standbein',
    boH2: 'Back Office: operative Unterstützung für KMU',
    boText: 'Verwaltung, Dokumente, E-Mails, Termine: Unser Büroteam übernimmt wiederkehrende Aufgaben, damit sich Ihr Team auf das Kerngeschäft konzentriert – auch unabhängig von einer Personalvermittlung.',
    boItems: [['Recruiting-Support', 'Bewerberunterlagen, Termine, Kommunikation.'], ['Logistik-Administration', 'Fahrer- und Fahrzeugunterlagen, Fristen.'], ['Dokumente & Datenerfassung', 'Sorgfältig, nach Ihren Vorlagen.'], ['E-Mail & Kundenkommunikation', 'Zuverlässig und auf Deutsch oder Englisch.']],
    boCta: 'Back-Office-Unterstützung anfragen', boMore: 'Alle Back-Office-Leistungen',
    procEyebrow: 'Ablauf', procH2: 'So funktioniert die Zusammenarbeit',
    whyEyebrow: 'Warum SION Consulting', whyH2: 'Darauf können Sie sich verlassen',
    why: [
      ['globe', 'Kandidaten aus der EU, dem Westbalkan und Deutschland', 'Fahrer mit Aufenthalt in der EU, Fachkräfte aus dem Westbalkan und Bewerber, die bereits in Deutschland leben.'],
      ['check', 'Vorgeprüfte Kandidaten', 'Erfahrung, Qualifikation und Unterlagen werden vor der Vorstellung geprüft.'],
      ['chat', 'Deutschsprachiger Ansprechpartner', 'Ein fester Kontakt für Sie – auf Deutsch oder Englisch.'],
      ['doc', 'Administrative Unterstützung', 'Hilfe bei Anträgen, Unterlagen und Organisation bis zum Arbeitsbeginn.'],
      ['eye', 'Transparenter Prozess', 'Klare Schritte, ehrliche Einschätzungen und regelmäßige Updates.'],
    ],
    appEyebrow: 'Für Bewerberinnen und Bewerber',
    appH2: 'Sie suchen einen Job in Deutschland?',
    appLinks: [['Für LKW-Fahrer in der EU', r('eufahrer')], ['Westbalkanregelung für LKW-Fahrer', r('westbalkan')]],
    appText: 'Wir vermitteln Fahrer und Arbeitskräfte, die in der EU leben oder aus dem Westbalkan kommen – kostenlos, direkt beim Arbeitgeber, ohne Zeitarbeit.',
    forDrivers: 'Für LKW-Fahrer', otherJobs: 'Andere Jobs',
    appCta: 'Jetzt bewerben', appCta2: 'Infos für Bewerber', heroApplicant: 'Sie suchen Arbeit?',
    bandH: 'Sie fahren schon in der EU?', bandSub: 'LKW-Fahrer mit Aufenthalt in der EU, C/CE und Code 95', bandGo: 'Jobs in Deutschland',
    trust: ['Direkte Anstellung', 'Keine Zeitarbeit', 'Kostenlos für Fahrer', 'Antwort in 1 Werktag'],
  },
  en: {
    title: 'Recruitment Agency for Truck Drivers & Logistics | SION',
    description: 'Truck drivers, parcel delivery, warehouse and cleaning staff for companies in Germany – plus back office. No deposit, payment after 30 days.',
    h1: 'Qualified truck drivers and logistics staff for your company',
    lead: 'We place pre-screened workers from Germany, the EU and the Western Balkans – with direct employment and personal support until the first working day.',
    lead2: 'We also take work off your administration with back-office services.',
    heroCta: 'Request staff now', heroCta2: 'I am looking for a job',
    procSteps: [['Tell us what you need', 'Position, number, location and start date – via the form or in a call.'], ['We search and pre-screen', 'We look for suitable applicants and check experience, licence and documents.'], ['Meet and choose', 'You hold the interviews – on site or by video – and decide yourself.'], ['Hiring and first day', 'We assist with paperwork and organisation until the first working day.']] as [string, string][],
    chips: [['Truck drivers', r('lkw')], ['Parcel delivery', r('paket')], ['Warehouse & logistics', r('lager')], ['Cleaning', r('reinigung')], ['Seasonal work', r('saison')], ['Back office', r('backoffice')]],
    chipsLabel: 'Our areas',
    services: 'Our services',
    callNow: 'Call now:',
    heroAlt: 'Truck driver standing in front of his semi-trailer truck',
    cardTitle: 'Your advantage',
    cardList: ['Pre-screened candidates', 'Direct employment in your company', 'One German-speaking contact person'],
    svcEyebrow: 'Recruitment',
    svcH2: 'Staff for transport, logistics and services',
    svcLead: 'Staff shortages, vacant driver positions, job ads without response? We find suitable employees from the EU, the Western Balkans and Germany and support the process up to the first working day.',
    svcAll: 'All recruitment services',
    lkwEyebrow: 'Our focus',
    lkwH2: 'Truck drivers from the EU, the Western Balkans and Germany – for your transport company',
    lkwText: 'The driver shortage is slowing down hauliers across Germany. We recruit experienced CE drivers – above all drivers who already drive in the EU with an EU licence and Code 95 –, screen them in advance and assist with all administrative steps – until the driver is on the road for you.',
    lkwList: ['CE drivers with professional experience', 'Pre-selection and an interview with you', 'Assistance with licence conversion and Code 95', 'Direct employment with you – no temporary agency work'],
    lkwCta: 'Request truck drivers', lkwCta2: 'Free initial consultation',
    lkwAlt: 'White truck on a country road at sunset',
    boEyebrow: 'Second business area',
    boH2: 'Back office: operational support for SMEs',
    boText: 'Administration, documents, emails, appointments: our office team handles recurring tasks so your team can focus on the core business – also independently of recruitment.',
    boItems: [['Recruitment support', 'Applicant files, scheduling, communication.'], ['Logistics administration', 'Driver and vehicle records, deadlines.'], ['Documents & data entry', 'Carefully, based on your templates.'], ['Email & customer communication', 'Reliable, in German or English.']],
    boCta: 'Request back-office support', boMore: 'All back-office services',
    procEyebrow: 'Process', procH2: 'How we work together',
    whyEyebrow: 'Why SION Consulting', whyH2: 'What you can rely on',
    why: [
      ['globe', 'Candidates from the EU, the Western Balkans and Germany', 'Drivers living in the EU, workers from the Western Balkans and applicants already living in Germany.'],
      ['check', 'Pre-screened candidates', 'Experience, qualifications and documents are checked before we present anyone.'],
      ['chat', 'German-speaking contact', 'One fixed contact person for you – in German or English.'],
      ['doc', 'Administrative support', 'Help with applications, documents and organisation up to the first day.'],
      ['eye', 'Transparent process', 'Clear steps, honest assessments and regular updates.'],
    ],
    appEyebrow: 'For applicants',
    appH2: 'Looking for a job in Germany?',
    appLinks: [['For truck drivers in the EU', r('eufahrer')], ['Western Balkans regulation for truck drivers', r('westbalkan')]],
    appText: 'We place drivers and workers who live in the EU or come from the Western Balkans – free of charge, directly with the employer, no temporary agency.',
    forDrivers: 'For truck drivers', otherJobs: 'Other jobs',
    appCta: 'Apply now', appCta2: 'Information for applicants', heroApplicant: 'Looking for work?',
    bandH: 'Already driving in the EU?', bandSub: 'Truck drivers living in the EU with C/CE and Code 95', bandGo: 'Jobs in Germany',
    trust: ['Direct employment', 'No temporary agency', 'Free for drivers', 'Reply in 1 working day'],
  },
}[lang];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'EmploymentAgency',
  name: site.name,
  url: site.url,
  email: site.email,
  address: { '@type': 'PostalAddress', streetAddress: site.street, postalCode: site.zip, addressLocality: site.city, addressCountry: 'AL' },
  areaServed: { '@type': 'Country', name: 'Germany' },
  knowsLanguage: ['de', 'en'],
};
---
<Base lang={lang} page="home" title={c.title} description={c.description} schema={schema} stickyCta={requestHref(lang)}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>{c.h1}</h1>
        <p class="lead hero-lead"><strong>{c.lead}</strong> <span class="hide-mobile">{c.lead2}</span></p>
        <ul class="chips" aria-label={c.chipsLabel}>
          {c.chips.map(([label, href], i) => <li><a class:list={['chip', { 'chip-accent': i === 0 }]} href={href}>{label}</a></li>)}
        </ul>
        <div class="btn-row hero-buttons">
          <a class="btn btn-accent btn-lg" href={requestHref(lang)}>{c.heroCta}</a>
          <a class="btn btn-ghost btn-lg" href={r('bewerber')}>{c.heroCta2}</a>
        </div>
      </div>
      <div class="hero-visual hide-mobile-block">
        <div class="media ratio-portrait">
          <Photo name="hero-lkw" alt={c.heroAlt} ratio="portrait" priority hideOnMobile sizes="(max-width: 760px) 1px, 45vw" />
        </div>
        <div class="hero-card">
          <p class="title">{c.cardTitle}</p>
          <ul class="checklist">{c.cardList.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <div class="container driver-band-wrap driver-band-top">
    <a class="driver-band" href={r('eufahrer')}>
      <span><strong>{c.bandH}</strong><span class="sub">{c.bandSub}</span></span>
      <span class="go">{c.bandGo} <Icon name="arrow" size={20} /></span>
    </a>
  </div>
  <div class="trust-strip trust-strip-home" role="note">
    <ul class="container">{c.trust.map((x) => <li><Icon name="check" size={18} />{x}</li>)}</ul>
  </div>

  <section id="leistungen" class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{c.svcEyebrow}</p>
        <h2>{c.svcH2}</h2>
        <p class="lead">{c.svcLead}</p>
      </div>
      <ServiceCards lang={lang} />
      <p class="section-more"><a class="link-arrow" href={r('personalvermittlung')}>{c.svcAll}</a></p>
    </div>
  </section>

  <section class="section band-sand" id="lkw">
    <div class="container grid-2">
      <div class="media ratio-landscape">
        <Photo name="lkw-fahrer" alt={c.lkwAlt} />
      </div>
      <div class="stack-lg">
        <p class="eyebrow">{c.lkwEyebrow}</p>
        <h2>{c.lkwH2}</h2>
        <p class="muted">{c.lkwText}</p>
        <ul class="checklist">{c.lkwList.map((x) => <li>{x}</li>)}</ul>
        <div class="btn-row">
          <a class="btn btn-accent btn-lg" href={`${r('lkw')}#anfrage`}>{c.lkwCta}</a>
          <a class="btn btn-ghost btn-lg" href={r('kontakt')}>{c.lkwCta2}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="back-office">
    <div class="container">
      <div class="feature-box grid-2" style="align-items: start">
        <div class="stack-lg">
          <p class="eyebrow">{c.boEyebrow}</p>
          <h2>{c.boH2}</h2>
          <p class="muted">{c.boText}</p>
          <div class="btn-row">
            <a class="btn btn-dark btn-lg" href={`${r('backoffice')}#anfrage`}>{c.boCta}</a>
            <a class="link-arrow" href={r('backoffice')}>{c.boMore}</a>
          </div>
        </div>
        <div class="mini-grid">
          {c.boItems.map(([h, p]) => <div class="mini"><strong>{h}</strong><p>{p}</p></div>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container"><PricingBox lang={lang} /></div>
  </section>

  <section id="ablauf" class="band-dark section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{c.procEyebrow}</p>
        <h2>{c.procH2}</h2>
      </div>
      <Steps lang={lang} steps={c.procSteps} />
      <div class="btn-row" style="margin-top: 36px"><a class="btn btn-accent btn-lg" href={requestHref(lang)}>{ui[lang].request}</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{c.whyEyebrow}</p>
        <h2>{c.whyH2}</h2>
      </div>
      <div class="why-grid">
        {c.why.map(([icon, h, p]) => <div class="value"><Icon name={icon} class="card-icon" /><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </div>
  </section>

  <Trust lang={lang} />

  <section id="bewerber" class="section band-soft">
    <div class="container applicant-band">
      <div class="stack">
        <p class="eyebrow">{c.appEyebrow}</p>
        <h2>{c.appH2}</h2>
        <p class="muted">{c.appText}</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-accent btn-lg" href={r('eufahrer')}>{c.forDrivers}</a>
        <a class="btn btn-ghost btn-lg" href={r('bewerber')}>{c.otherJobs}</a>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
