---
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import ChatWidget from '../components/ChatWidget.astro';
import MobileBar from '../components/MobileBar.astro';
import Icon from '../components/Icon.astro';
import { routes, ui, type Lang, type PageKey } from '../i18n';
import { site } from '../config';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
  noindex?: boolean;
  schema?: unknown;
  image?: string;
  // 'candidate': page for job seekers – no info@ (employer) address anywhere, apply button in the mobile bar
  audience?: 'employer' | 'candidate';
  // Employer pages: sticky "Personal anfragen" button (desktop) that jumps to this anchor/URL
  stickyCta?: string;
}
const { lang, page, title, description, noindex = false, schema, image = '/images/og-image.jpg', audience = 'employer', stickyCta } = Astro.props;
const abs = (path: string) => new URL(path, site.url).href;
const canonical = abs(routes[page][lang]);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={abs(routes[page].de)} />
    <link rel="alternate" hreflang="en" href={abs(routes[page].en)} />
    <link rel="alternate" hreflang="x-default" href={abs(routes[page].de)} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SION Consulting" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(image)} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#12212E" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {schema && (Array.isArray(schema)
      ? schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)
      : <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    <script is:inline>
      try {
        var q = new URLSearchParams(location.search), u = {}, has = false;
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach(function (k) { var v = q.get(k); if (v) { u[k] = v.slice(0, 120); has = true; } });
        if (has) sessionStorage.setItem('sion-utm', JSON.stringify(u));
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{ui[lang].skip}</a>
    <Header lang={lang} page={page} audience={audience} />
    <main id="main"><slot /></main>
    <Footer lang={lang} audience={audience} />
    <MobileBar lang={lang} audience={audience} />
    {stickyCta && <a class="sticky-cta btn btn-accent" href={stickyCta}><Icon name="users" size={20} /> {ui[lang].request}</a>}
    <ChatWidget lang={lang} audience={audience} />
    <CookieBanner lang={lang} />
  </body>
</html>
