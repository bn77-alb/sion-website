---
import headingFont from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url';
import bodyFont from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import ChatWidget from '../components/ChatWidget.astro';
import MobileBar from '../components/MobileBar.astro';
import Icon from '../components/Icon.astro';
import { routes, ui, type Lang, type PageKey } from '../i18n';
import { site, isSet } from '../config';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
  noindex?: boolean;
  schema?: unknown;
  image?: string;
  // 'candidate': page for job seekers – no info@ (employer) address anywhere, apply button in the mobile bar
  audience?: 'employer' | 'candidate';
  // Employer pages: sticky "Personal anfragen" button (desktop) that jumps to this anchor/URL
  stickyCta?: string;
  // 'driver': lean header and mobile bar for the truck driver pages
  layout?: 'default' | 'driver';
}
const { lang, page, title, description, noindex = false, schema, image = '/images/og-image.jpg', audience = 'employer', stickyCta, layout = 'default' } = Astro.props;
const abs = (path: string) => new URL(path, site.url).href;
const canonical = abs(routes[page][lang]);
// Structured data added on every page: breadcrumb (sub pages), WebSite + Organization (home), ContactPage (contact)
const pageName = title.split(' | ')[0].split(' – ')[0].split(': ')[0];
const extraSchema: Record<string, unknown>[] = [];
if (page === 'home') {
  extraSchema.push({ '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: abs(routes.home[lang]), inLanguage: lang });
} else {
  extraSchema.push({
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.name, item: abs(routes.home[lang]) },
      { '@type': 'ListItem', position: 2, name: pageName, item: canonical },
    ],
  });
}
if (page === 'kontakt') {
  extraSchema.push({ '@context': 'https://schema.org', '@type': 'ContactPage', name: pageName, url: canonical, inLanguage: lang, about: { '@type': 'EmploymentAgency', name: site.name, url: site.url, email: site.email } });
}
const allSchema = [...(schema ? (Array.isArray(schema) ? schema : [schema]) : []), ...extraSchema];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {isSet(site.googleSiteVerification) && <meta name="google-site-verification" content={site.googleSiteVerification} />}
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={abs(routes[page].de)} />
    <link rel="alternate" hreflang="en" href={abs(routes[page].en)} />
    <link rel="alternate" hreflang="x-default" href={abs(routes[page].de)} />
    {import.meta.env.PUBLIC_STAGING ? <meta name="robots" content="noindex, nofollow" /> : noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SION Consulting" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(image)} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#12212E" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {allSchema.map((sc) => <script type="application/ld+json" set:html={JSON.stringify(sc)} />)}
    <script>
      // First page of the visit: remember channel, referrer and UTM parameters for the forms
      import { classify } from '../scripts/attribution';
      try {
        if (!sessionStorage.getItem('sion-attr')) {
          const q = new URLSearchParams(location.search);
          const utm: Record<string, string> = {};
          ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach((k) => { const v = q.get(k); if (v) utm[k] = v.slice(0, 120); });
          let ref = '';
          try { const r = new URL(document.referrer); if (r.host !== location.host) ref = r.origin; } catch { /* none */ }
          sessionStorage.setItem('sion-attr', JSON.stringify({ ...utm, referrer: ref, landingPage: location.pathname, channel: classify(ref, utm) }));
        }
      } catch { /* storage blocked */ }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{ui[lang].skip}</a>
    <Header lang={lang} page={page} audience={audience} layout={layout} />
    <main id="main"><slot /></main>
    <Footer lang={lang} audience={audience} />
    <MobileBar lang={lang} audience={audience} layout={layout} onApplyPage={page === 'eufahrer'} />
    {stickyCta && <a class="sticky-cta btn btn-accent" href={stickyCta}><Icon name="users" size={20} /> {ui[lang].request}</a>}
    <ChatWidget lang={lang} audience={audience} />
    <CookieBanner lang={lang} />
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
