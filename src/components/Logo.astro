---
// SION Consulting logo (emblem + wordmark). Source: logo file from Bern, 25 Nov 2026.
// File: public/images/logo-header.webp (PNG fallback next to it), 460 × 120 px.
interface Props { height?: number; class?: string }
const { height = 44, class: cls } = Astro.props;
const width = Math.round((height * 460) / 120);
---
<picture class={cls}>
  <source srcset="/images/logo-header.webp" type="image/webp" />
  <img src="/images/logo-header.png" alt="SION Consulting" width={width} height={height} decoding="async" />
</picture>
