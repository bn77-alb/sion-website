---
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const steps = {
  de: [
    { title: 'Bedarf aufnehmen', text: 'Wir klären Position, Anzahl, Einsatzort, Arbeitszeiten und Anforderungen wie Führerscheinklasse oder Berufserfahrung.' },
    { title: 'Kandidaten auswählen', text: 'Vorauswahl im Westbalkan und international, persönliche Gespräche, Prüfung von Pass, Führerschein und Nachweisen. Sie erhalten passende Profile und entscheiden selbst.' },
    { title: 'Vertrag & Antrag vorbereiten', text: 'Wir bereiten Arbeitsvertrag und Antrag vor und prüfen alle visarelevanten Details, bevor etwas eingereicht wird.' },
    { title: 'Zustimmung der Bundesagentur', text: 'Die Bundesagentur für Arbeit prüft den Antrag. Wir behalten den Status im Blick und halten Sie auf dem Laufenden.' },
    { title: 'Visumverfahren', text: 'Termin und Unterlagen bei der deutschen Auslandsvertretung – vollständig vorbereitet und begleitet.' },
    { title: 'Einreise & Arbeitsbeginn', text: 'Anmeldung, Antrag auf Aufenthaltstitel und Begleitung in den ersten Wochen – damit der Start bei Ihnen reibungslos gelingt.' },
  ],
  en: [
    { title: 'Define your needs', text: 'We clarify the position, number of hires, location, working hours and requirements such as licence class or experience.' },
    { title: 'Select candidates', text: 'Pre-selection in the Western Balkans and internationally, interviews, and checks of passport, driving licence and certificates. You receive matching profiles and make the final decision.' },
    { title: 'Prepare contract & application', text: 'We prepare the employment contract and application and check every visa-relevant detail before anything is submitted.' },
    { title: 'Federal Employment Agency approval', text: 'The Federal Employment Agency (Bundesagentur für Arbeit) reviews the application. We track the status and keep you informed.' },
    { title: 'Visa process', text: 'Appointment and documents at the German embassy or consulate – fully prepared and supported.' },
    { title: 'Arrival & first day', text: 'Registration, residence permit application and support during the first weeks – so the start in your company runs smoothly.' },
  ],
}[lang];
const label = lang === 'de' ? 'Ablauf in sechs Schritten' : 'Process in six steps';
---
<div class="process" data-process>
  <div class="process-list" role="tablist" aria-label={label} aria-orientation="vertical">
    {steps.map((s, i) => (
      <button type="button" role="tab" class="process-tab" id={`step-tab-${i}`} aria-controls={`step-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
        <span class="num">0{i + 1}</span><span>{s.title}</span>
      </button>
    ))}
  </div>
  <div>
    {steps.map((s, i) => (
      <div class="process-panel" role="tabpanel" id={`step-panel-${i}`} aria-labelledby={`step-tab-${i}`} hidden={i !== 0}>
        <span class="big" aria-hidden="true">0{i + 1}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </div>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll('[data-process]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, j) => {
        tab.setAttribute('aria-selected', String(index === j));
        tab.tabIndex = index === j ? 0 : -1;
      });
      panels.forEach((panel, j) => { panel.hidden = index !== j; });
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); select((i + 1) % tabs.length, true); }
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); select((i - 1 + tabs.length) % tabs.length, true); }
      });
    });
  });
</script>
