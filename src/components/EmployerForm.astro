---
// "Personal anfragen" – inquiry form for companies.
import { routes, type Lang } from '../i18n';
import { site } from '../config';
// variant 'lkw': fixed position (truck drivers), asks for the number of drivers instead of a position.
interface Props { lang: Lang; position?: string; variant?: 'general' | 'lkw' | 'saison' }
const { lang, position = '', variant = 'general' } = Astro.props;
const isLkw = variant === 'lkw';

const t = {
  de: {
    company: 'Unternehmen', contact: 'Ansprechpartner', phone: 'Telefonnummer', email: 'E-Mail', location: 'Standort',
    locationPh: 'z. B. Nürnberg', position: 'Gesuchte Position', choose: 'Bitte wählen', count: 'Anzahl Mitarbeiter',
    start: 'Gewünschter Starttermin', message: 'Nachricht', drivers: 'Anzahl Fahrer', lkwValue: 'LKW-Fahrer', lkwPh: 'z. B. Führerscheinklasse, Touren, Fahrzeugtyp, Arbeitszeiten, Unterkunft',
    messagePh: 'z. B. Führerscheinklasse, Touren, Arbeitszeiten, Unterkunft – oder welche Back-Office-Aufgaben Sie abgeben möchten',
    starts: ['So schnell wie möglich', 'Innerhalb von 1 Monat', 'In 1–3 Monaten', 'In mehr als 3 Monaten', 'Noch offen'],
    positions: [['lkw', 'LKW-Fahrer'], ['paket', 'Paketzusteller'], ['lager', 'Lagerarbeiter'], ['reinigung', 'Reinigungskräfte'], ['saison-bau', 'Saisonkräfte – Bau'], ['saison-reinigung', 'Saisonkräfte – Reinigung'], ['saison-hotel', 'Saisonkräfte – Hotel & Gastronomie'], ['backoffice', 'Back Office'], ['andere', 'Andere']],
    consentA: 'Ich habe die', privacy: 'Datenschutzerklärung', consentB: 'gelesen und bin einverstanden, dass meine Angaben zur Bearbeitung der Anfrage verarbeitet werden.',
    required: 'Pflichtfelder', submit: 'Anfrage senden', reply: 'Antwort innerhalb von 1 Werktag – unverbindlich.',
    sending: 'Wird gesendet …',
    ok: 'Vielen Dank! Ihre Anfrage ist bei uns eingegangen. Wir melden uns innerhalb von 1 Werktag.',
    err: `Das Senden hat leider nicht geklappt. Bitte rufen Sie uns an (${site.phone}) oder schreiben Sie an ${site.email}.`,
    mail: 'Ihr E-Mail-Programm wird geöffnet. Bitte senden Sie die vorbereitete Nachricht ab.',
    subject: 'Personalanfrage über sionconsulting.de',
  },
  en: {
    company: 'Company', contact: 'Contact person', phone: 'Phone number', email: 'Email', location: 'Location',
    locationPh: 'e.g. Nuremberg', position: 'Position needed', choose: 'Please choose', count: 'Number of employees',
    start: 'Preferred start date', message: 'Message', drivers: 'Number of drivers', lkwValue: 'Truck drivers', lkwPh: 'e.g. licence class, routes, vehicle type, working hours, accommodation',
    messagePh: 'e.g. licence class, routes, working hours, accommodation – or which back-office tasks you want to hand over',
    starts: ['As soon as possible', 'Within 1 month', 'In 1–3 months', 'In more than 3 months', 'Not decided yet'],
    positions: [['lkw', 'Truck drivers'], ['paket', 'Parcel delivery drivers'], ['lager', 'Warehouse workers'], ['reinigung', 'Cleaning staff'], ['saison-bau', 'Seasonal workers – construction'], ['saison-reinigung', 'Seasonal workers – cleaning'], ['saison-hotel', 'Seasonal workers – hotel & restaurant'], ['backoffice', 'Back office'], ['andere', 'Other']],
    consentA: 'I have read the', privacy: 'privacy policy', consentB: 'and agree that my details are processed to handle this inquiry.',
    required: 'required fields', submit: 'Send inquiry', reply: 'Reply within 1 working day – no obligation.',
    sending: 'Sending …',
    ok: 'Thank you! We have received your inquiry and will get back to you within 1 working day.',
    err: `Sending failed. Please call us (${site.phone}) or email ${site.email}.`,
    mail: 'Your email program will open. Please send the prepared message.',
    subject: 'Staff inquiry via sionconsulting.de',
  },
}[lang];
const id = (n: string) => `emp-${n}`;
---
<form class="form" data-sion-form data-form-type="employer"
  data-endpoint={site.formEndpoint} data-email={site.email} data-lang={lang}
  data-msg-sending={t.sending} data-msg-ok={t.ok} data-msg-err={t.err} data-msg-mail={t.mail} data-subject={t.subject}>
  <div class="form-row">
    <label class="field" for={id('company')}>
      <span>{t.company} <span class="req" aria-hidden="true">*</span></span>
      <input id={id('company')} name="company" data-label={t.company} type="text" required autocomplete="organization" />
    </label>
    <label class="field" for={id('name')}>
      <span>{t.contact} <span class="req" aria-hidden="true">*</span></span>
      <input id={id('name')} name="name" data-label={t.contact} type="text" required autocomplete="name" />
    </label>
  </div>
  <div class="form-row">
    <label class="field" for={id('phone')}>
      <span>{t.phone} <span class="req" aria-hidden="true">*</span></span>
      <input id={id('phone')} name="phone" data-label={t.phone} type="tel" required autocomplete="tel" inputmode="tel" />
    </label>
    <label class="field" for={id('email')}>
      <span>{t.email} <span class="req" aria-hidden="true">*</span></span>
      <input id={id('email')} name="email" data-label={t.email} type="email" required autocomplete="email" />
    </label>
  </div>
  {isLkw ? (
    <input type="hidden" name="position" data-label={t.position} value={t.lkwValue} />
  ) : null}
  <div class="form-row">
    {isLkw ? (
      <label class="field" for={id('count')}>
        <span>{t.drivers}</span>
        <input id={id('count')} name="count" data-label={t.drivers} type="number" min="1" max="500" inputmode="numeric" />
      </label>
    ) : (
      <label class="field" for={id('position')}>
        <span>{t.position} <span class="req" aria-hidden="true">*</span></span>
        <select id={id('position')} name="position" data-label={t.position} required>
          <option value="">{t.choose}</option>
          {t.positions.filter(([v]) => variant !== 'saison' || v.startsWith('saison')).map(([v, l]) => <option value={l} selected={v === position}>{l}</option>)}
        </select>
      </label>
    )}
    <label class="field" for={id('location')}>
      <span>{t.location}</span>
      <input id={id('location')} name="location" data-label={t.location} type="text" placeholder={t.locationPh} autocomplete="address-level2" />
    </label>
  </div>
  <div class="form-row">
    {!isLkw && (
      <label class="field" for={id('count')}>
        <span>{t.count}</span>
        <input id={id('count')} name="count" data-label={t.count} type="number" min="1" max="500" inputmode="numeric" />
      </label>
    )}
    <label class="field" for={id('start')}>
      <span>{t.start}</span>
      <select id={id('start')} name="start" data-label={t.start}>
        <option value="">{t.choose}</option>
        {t.starts.map((s) => <option value={s}>{s}</option>)}
      </select>
    </label>
  </div>
  <label class="field" for={id('message')}>
    <span>{t.message}</span>
    <textarea id={id('message')} name="message" data-label={t.message} rows="4" placeholder={isLkw ? t.lkwPh : t.messagePh}></textarea>
  </label>
  <div class="hp" aria-hidden="true"><input name="website" type="text" tabindex="-1" autocomplete="off" /></div>
  <label class="consent">
    <input type="checkbox" name="consent" value="yes" required />
    <span>{t.consentA} <a href={routes.datenschutz[lang]}>{t.privacy}</a> {t.consentB} <span class="req" aria-hidden="true">*</span></span>
  </label>
  <div class="form-submit">
    <button type="submit" class="btn btn-accent btn-lg">{t.submit}</button>
    <p class="form-note"><span class="req">*</span> {t.required} · {t.reply}</p>
  </div>
  <p class="form-status" role="status" aria-live="polite" hidden></p>
</form>

<script>
  import '../scripts/forms';
</script>
