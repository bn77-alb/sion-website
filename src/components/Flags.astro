---
// Row of EU flags (countries drivers often come from) with an arrow to the German flag.
// SVG flags from the flag-icons package (MIT) – emoji flags don't show on Windows.
import Icon from './Icon.astro';
import { countryName } from '../lib/countries';
import type { Lang } from '../i18n';
interface Props { lang: Lang; label: string }
const { lang, label } = Astro.props;
const svgs = import.meta.glob('/node_modules/flag-icons/flags/4x3/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const flag = (code: string) => svgs[`/node_modules/flag-icons/flags/4x3/${code.toLowerCase()}.svg`] || '';
const from = ['PL', 'LT', 'LV', 'NL', 'CZ', 'SK', 'HU', 'RO', 'HR', 'SI'];
---
<div class="flag-row" role="img" aria-label={label}>
  <span class="flags">
    {from.map((c) => <span class="flag" title={countryName(c, lang)} set:html={flag(c)} />)}
  </span>
  <Icon name="arrow" size={30} class="flag-arrow" />
  <span class="flag flag-lg" title={countryName('DE', lang)} set:html={flag('DE')} />
</div>
