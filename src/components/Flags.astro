---
// Two labelled flag rows on the EU driver page: where drivers live, and where they come from.
// Flags are decorative (alt="", aria-hidden); the country names are visible text.
// SVG flags from the flag-icons package (MIT) – emoji flags don't show on Windows.
import { countryName } from '../lib/countries';
import type { Lang } from '../i18n';
import plFlag from 'flag-icons/flags/4x3/pl.svg?url';
import ltFlag from 'flag-icons/flags/4x3/lt.svg?url';
import lvFlag from 'flag-icons/flags/4x3/lv.svg?url';
import czFlag from 'flag-icons/flags/4x3/cz.svg?url';
import skFlag from 'flag-icons/flags/4x3/sk.svg?url';
import nlFlag from 'flag-icons/flags/4x3/nl.svg?url';
import huFlag from 'flag-icons/flags/4x3/hu.svg?url';
import roFlag from 'flag-icons/flags/4x3/ro.svg?url';
import uaFlag from 'flag-icons/flags/4x3/ua.svg?url';
import byFlag from 'flag-icons/flags/4x3/by.svg?url';
import uzFlag from 'flag-icons/flags/4x3/uz.svg?url';
import kzFlag from 'flag-icons/flags/4x3/kz.svg?url';
import geFlag from 'flag-icons/flags/4x3/ge.svg?url';
import mdFlag from 'flag-icons/flags/4x3/md.svg?url';
import inFlag from 'flag-icons/flags/4x3/in.svg?url';
import phFlag from 'flag-icons/flags/4x3/ph.svg?url';
interface Props { lang: Lang }
const { lang } = Astro.props;
const flags: Record<string, string> = { PL: plFlag, LT: ltFlag, LV: lvFlag, CZ: czFlag, SK: skFlag, NL: nlFlag, HU: huFlag, RO: roFlag, UA: uaFlag, BY: byFlag, UZ: uzFlag, KZ: kzFlag, GE: geFlag, MD: mdFlag, IN: inFlag, PH: phFlag };
const rows = [
  { label: lang === 'de' ? 'Sie leben in:' : 'You live in:', codes: ['PL', 'LT', 'LV', 'CZ', 'SK', 'NL', 'HU', 'RO'] },
  { label: lang === 'de' ? 'Wir vermitteln Fahrer aus:' : 'We place drivers from:', codes: ['UA', 'BY', 'UZ', 'KZ', 'GE', 'MD', 'IN', 'PH'] },
];
---
<div class="flag-rows">
  {rows.map((row) => (
    <div class="flag-row-labelled">
      <p class="flag-row-label">{row.label}</p>
      <ul class="flag-list">
        {row.codes.map((c) => (
          <li><img class="flag" src={flags[c]} alt="" aria-hidden="true" width="28" height="21" loading="lazy" decoding="async" /><span>{countryName(c, lang)}</span></li>
        ))}
      </ul>
    </div>
  ))}
</div>
