---
// Responsive photo: AVIF + WebP in several widths, so phones download small files.
// hideOnMobile: phones get a 1-pixel placeholder instead of the photo (used for the hero).
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import heroLkw from '../assets/images/hero-lkw.jpg';
import lkwFahrer from '../assets/images/lkw-fahrer.jpg';
import lkwStrasse from '../assets/images/lkw-strasse.jpg';
import lager from '../assets/images/lager.jpg';
import backoffice from '../assets/images/backoffice.jpg';

const library: Record<string, ImageMetadata> = { 'hero-lkw': heroLkw, 'lkw-fahrer': lkwFahrer, 'lkw-strasse': lkwStrasse, lager, backoffice };

interface Props {
  name: keyof typeof library | string;
  alt: string;
  sizes?: string;
  priority?: boolean;
  hideOnMobile?: boolean;
  ratio?: 'portrait' | 'landscape' | 'wide';
}
const { name, alt, sizes = '(max-width: 760px) 100vw, 50vw', priority = false, hideOnMobile = false, ratio = 'landscape' } = Astro.props;
const src = library[name];
const widths = [480, 768, 1080, 1440].filter((w) => w <= src.width);
const [avif, webp, jpg] = await Promise.all([
  getImage({ src, widths, format: 'avif', quality: 55 }),
  getImage({ src, widths, format: 'webp', quality: 70 }),
  getImage({ src, width: 1080, format: 'jpg', quality: 72 }),
]);
const blank = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
const dims = { portrait: [1080, 1350], landscape: [1200, 900], wide: [1600, 900] }[ratio];
---
<picture>
  {hideOnMobile && <source media="(max-width: 760px)" srcset={blank} />}
  <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
  <source type="image/webp" srcset={webp.srcSet.attribute} sizes={sizes} />
  <img src={jpg.src} alt={alt} width={dims[0]} height={dims[1]}
    loading={priority ? 'eager' : 'lazy'} decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : undefined} />
</picture>
