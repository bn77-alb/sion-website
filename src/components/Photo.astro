---
// Responsive photo: AVIF + WebP in several widths, so phones download small files.
// Photos live in src/assets/images/<name>.jpg. A missing photo renders nothing (see hasPhoto()).
// hideOnMobile: phones get a 1-pixel placeholder instead of the photo (used for page heroes).
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { photoFor } from '../lib/photos';

interface Props {
  name: string;
  alt: string;
  sizes?: string;
  priority?: boolean;
  hideOnMobile?: boolean;
  ratio?: 'portrait' | 'landscape' | 'wide';
  focus?: string; // CSS object-position, e.g. '50% 75%'
}
const { name, alt, sizes = '(max-width: 760px) 100vw, 50vw', priority = false, hideOnMobile = false, ratio = 'landscape', focus } = Astro.props;
const src: ImageMetadata | undefined = photoFor(name);
const blank = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
const dims = { portrait: [1080, 1350], landscape: [1200, 900], wide: [1600, 900] }[ratio];
let sources: { avif: string; webp: string; jpg: string } | null = null;
if (src) {
  const widths = [480, 768, 1080, 1440].filter((w) => w <= src.width);
  const [avif, webp, jpg] = await Promise.all([
    getImage({ src, widths, format: 'avif', quality: 55 }),
    getImage({ src, widths, format: 'webp', quality: 70 }),
    getImage({ src, width: Math.min(1080, src.width), format: 'jpg', quality: 72 }),
  ]);
  sources = { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, jpg: jpg.src };
}
---
{sources && (
  <picture>
    {hideOnMobile && <source media="(max-width: 760px)" srcset={blank} />}
    <source type="image/avif" srcset={sources.avif} sizes={sizes} />
    <source type="image/webp" srcset={sources.webp} sizes={sizes} />
    <img src={sources.jpg} alt={alt} width={dims[0]} height={dims[1]}
      loading={priority ? 'eager' : 'lazy'} decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : undefined} style={focus ? `object-position: ${focus}` : undefined} />
  </picture>
)}
