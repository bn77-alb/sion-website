---
import Icon from './Icon.astro';
import { routes, ui, type Lang } from '../i18n';
import { site } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const year = new Date().getFullYear();
const r = (k: keyof typeof routes) => routes[k][lang];
const t = {
  de: {
    claim: 'SION Consulting unterstützt Unternehmen in Deutschland bei Personalbedarf und operativen Aufgaben – mit Personalvermittlung und Back-Office-Services.',
    services: 'Leistungen', company: 'Unternehmen', contact: 'Kontakt',
    links: [['Personalvermittlung', r('personalvermittlung')], ['LKW-Fahrer', r('lkw')], ['Paketzusteller', r('paket')], ['Lager & Logistik', r('lager')], ['Reinigung', r('reinigung')], ['Saisonarbeit', r('saison')], ['Back Office', r('backoffice')]],
    company2: [['Für Unternehmen', r('unternehmen')], ['Für Bewerber', r('bewerber')], ['Über uns', r('ueberuns')], ['Kontakt', r('kontakt')]],
    office: 'Büro', country: site.countryDe, langs: 'Deutsch & Englisch',
    rights: 'Alle Rechte vorbehalten.',
    impressum: 'Impressum', privacy: 'Datenschutz', cookieSettings: 'Cookie-Einstellungen', contactLink: 'Kontakt', legal: 'Rechtliche Hinweise',
  },
  en: {
    claim: 'SION Consulting helps companies in Germany with staffing needs and operational tasks – through recruitment and back-office services.',
    services: 'Services', company: 'Company', contact: 'Contact',
    links: [['Recruitment', r('personalvermittlung')], ['Truck drivers', r('lkw')], ['Parcel delivery drivers', r('paket')], ['Warehouse & logistics', r('lager')], ['Cleaning staff', r('reinigung')], ['Seasonal work', r('saison')], ['Back office', r('backoffice')]],
    company2: [['For employers', r('unternehmen')], ['For applicants', r('bewerber')], ['About us', r('ueberuns')], ['Contact', r('kontakt')]],
    office: 'Office', country: site.countryEn, langs: 'German & English',
    rights: 'All rights reserved.',
    impressum: 'Legal notice', privacy: 'Privacy', cookieSettings: 'Cookie settings', contactLink: 'Contact', legal: 'Legal information',
  },
}[lang];
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-about">
      <p class="footer-brand">SION Consulting</p>
      <p>{t.claim}</p>
      <a class="footer-phone" href={`tel:${site.phoneHref}`}><Icon name="phone" size={20} /> {site.phone}</a>
      <a class="footer-mail" href={`mailto:${site.email}`}><Icon name="mail" size={20} /> {site.email}</a>
    </div>
    <div>
      <p class="footer-title">{t.services}</p>
      <ul class="footer-list">{t.links.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
    </div>
    <div>
      <p class="footer-title">{t.company}</p>
      <ul class="footer-list">{t.company2.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
    </div>
    <div>
      <p class="footer-title">{t.contact}</p>
      <ul class="footer-list">
        <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>{t.langs}</li>
        <li><span class="footer-sub">{t.office}</span><br />{site.street}<br />{site.zip} {site.city}, {t.country}</li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} SION Consulting. {t.rights}</span>
    <nav aria-label={t.legal} class="footer-legal">
      <a href={r('impressum')}>{t.impressum}</a>
      <a href={r('datenschutz')}>{t.privacy}</a>
      <button type="button" class="linklike" data-cookie-open>{t.cookieSettings}</button>
      <a href={r('kontakt')}>{t.contactLink}</a>
    </nav>
  </div>
</footer>
